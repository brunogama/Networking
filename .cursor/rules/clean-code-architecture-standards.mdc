## **OBJECT CALISTHENICS PRINCIPLES**

### **2. Don't Use the ELSE Keyword**
- **Rule**: Avoid else statements entirely
- **Rationale**: Reduces cyclomatic complexity and improves readability
- **Implementation**: Use early returns, guard clauses, or polymorphism

```swift
// ✅ GOOD: No else statements
func processOrder(_ order: Order) -> Result<ProcessedOrder, OrderError> {
    guard order.isValid else { return .failure(.invalidOrder) }
    guard order.hasItems else { return .failure(.emptyOrder) }
    guard order.customer.isActive else { return .failure(.inactiveCustomer) }

    let processedOrder = transformOrder(order)
    return .success(processedOrder)
}

func getDiscountType(for customer: Customer) -> DiscountType {
    guard customer.isPremium else { return .standard }
    guard customer.yearsActive >= 5 else { return .premium }

    return .platinum
}

// ❌ BAD: Using else statements
func processOrderBad(_ order: Order) -> Result<ProcessedOrder, OrderError> {
    if order.isValid {
        if order.hasItems {
            let processedOrder = transformOrder(order)
            return .success(processedOrder)
        } else {
            return .failure(.emptyOrder)
        }
    } else {
        return .failure(.invalidOrder)
    }
}
```

### **3. Wrap All Primitives and Strings**
- **Rule**: No naked primitives - wrap them in value objects
- **Rationale**: Adds type safety, domain meaning, and prevents primitive obsession
- **Implementation**: Create value types for domain concepts

```swift
// ✅ GOOD: Wrapped primitives
struct UserId {
    let value: String

    init?(_ value: String) {
        guard !value.isEmpty else { return nil }
        self.value = value
    }
}

struct EmailAddress {
    let value: String

    init?(_ value: String) {
        guard value.contains("@") && value.contains(".") else { return nil }
        self.value = value
    }
}

struct Money {
    let amount: Decimal
    let currency: Currency

    init(amount: Decimal, currency: Currency = .usd) {
        self.amount = amount
        self.currency = currency
    }
}

func createUser(id: UserId, email: EmailAddress, salary: Money) -> User {
    return User(id: id, email: email, salary: salary)
}

// ❌ BAD: Naked primitives
func createUserBad(id: String, email: String, salary: Double) -> User {
    // No type safety, easy to mix up parameters
    return User(id: id, email: email, salary: salary)
}
```

### **4. First Class Collections**
- **Rule**: Any class containing a collection should contain nothing else
- **Rationale**: Promotes collection-specific behavior and encapsulation
- **Implementation**: Wrap collections in dedicated classes

```swift
// ✅ GOOD: First class collections
struct UserList {
    private let users: [User]

    init(_ users: [User]) {
        self.users = users
    }

    func activeUsers() -> UserList {
        let active = users.filter { $0.isActive }
        return UserList(active)
    }

    func findBy(email: EmailAddress) -> User? {
        return users.first { $0.email == email }
    }

    var count: Int { users.count }
    var isEmpty: Bool { users.isEmpty }
}

struct OrderItems {
    private let items: [OrderItem]

    init(_ items: [OrderItem]) {
        self.items = items
    }

    func totalPrice() -> Money {
        let total = items.reduce(Decimal.zero) { $0 + $1.price.amount }
        return Money(amount: total)
    }

    func itemsBy(category: Category) -> OrderItems {
        let filtered = items.filter { $0.category == category }
        return OrderItems(filtered)
    }
}

// ❌ BAD: Mixed responsibilities
class UserManager {
    let users: [User]  // Collection mixed with other responsibilities
    let database: Database
    let logger: Logger

    func addUser(_ user: User) { }
    func removeUser(_ user: User) { }
    func logActivity(_ activity: String) { }
}
```

### **5. One Dot per Line**
- **Rule**: Avoid method chaining - maximum one dot per line
- **Rationale**: Promotes Law of Demeter and reduces coupling
- **Implementation**: Use intermediate variables or Tell Don't Ask

```swift
// ✅ GOOD: One dot per line
func processUserOrder(_ user: User) -> Result<Receipt, ProcessingError> {
    let address = user.shippingAddress
    let validator = address.validator
    let validationResult = validator.validate()

    guard validationResult.isValid else {
        return .failure(.invalidAddress)
    }

    let order = user.currentOrder
    let processor = OrderProcessor(address: address)
    let receipt = processor.process(order)

    return .success(receipt)
}

// ✅ GOOD: Tell Don't Ask approach
func calculateShippingCost(for user: User) -> Money {
    let shippingCalculator = ShippingCalculator()
    return shippingCalculator.calculateFor(user: user)
}

// ❌ BAD: Method chaining
func processUserOrderBad(_ user: User) -> Result<Receipt, ProcessingError> {
    guard user.getAddress().getValidator().validate().isValid else {
        return .failure(.invalidAddress)
    }

    let receipt = user.getCurrentOrder().getProcessor().process()
    return .success(receipt)
}
```

### **6. Don't Abbreviate**
- **Rule**: Use full, descriptive names - no abbreviations
- **Rationale**: Code should read like well-written prose
- **Implementation**: Prefer clarity over brevity

```swift
// ✅ GOOD: Full descriptive names
struct UserAuthenticationService {
    func authenticateUser(credentials: UserCredentials) -> AuthenticationResult {
        let validator = CredentialValidator()
        let validationResult = validator.validate(credentials)

        guard validationResult.isValid else {
            return .failure(.invalidCredentials)
        }

        let tokenGenerator = AuthenticationTokenGenerator()
        let authenticationToken = tokenGenerator.generate(for: credentials.userId)

        return .success(authenticationToken)
    }
}

struct DatabaseConnectionManager {
    func establishConnection(to configuration: DatabaseConfiguration) -> DatabaseConnection {
        // Clear, unambiguous names
    }
}

// ❌ BAD: Abbreviations
struct UsrAuthSvc {
    func authUsr(creds: UsrCreds) -> AuthRes {
        let validator = CredValidator()
        let valRes = validator.val(creds)
        // Unclear, abbreviated names
    }
}

struct DbConnMgr {
    func estConn(to cfg: DbCfg) -> DbConn {
        // Cryptic abbreviations
    }
}
```

### **7. Keep All Entities Small**
- **Rule**: Classes max 50 lines, methods max 5 lines, packages max 10 files
- **Rationale**: Forces proper decomposition and single responsibility
- **Implementation**: Extract when limits are exceeded

```swift
// ✅ GOOD: Small entities (under limits)
struct User {  // ~15 lines
    let id: UserId
    let email: EmailAddress
    let profile: UserProfile

    func isActive() -> Bool {
        return profile.status == .active
    }
}

struct UserValidator {  // ~20 lines
    func validate(_ user: User) -> ValidationResult {
        guard isEmailValid(user.email) else { return .invalid(.email) }
        guard isProfileComplete(user.profile) else { return .invalid(.profile) }
        return .valid
    }

    private func isEmailValid(_ email: EmailAddress) -> Bool {
        return email.value.contains("@")
    }

    private func isProfileComplete(_ profile: UserProfile) -> Bool {
        return !profile.name.isEmpty
    }
}

// ❌ BAD: Large entities (exceeding limits)
struct UserManagerGod {  // 150+ lines - TOO BIG!
    // Too many responsibilities, methods, and lines
    func validateUser() { }
    func saveUser() { }
    func sendEmail() { }
    func generateReport() { }
    func processPayment() { }
    // ... many more methods
}
```

### **8. No Classes with More Than Two Instance Variables**
- **Rule**: Classes should have at most 2 instance variables
- **Rationale**: Promotes high cohesion and proper object composition
- **Implementation**: Use composition and delegation

```swift
// ✅ GOOD: Maximum 2 instance variables
struct UserService {
    private let repository: UserRepositoryProtocol
    private let validator: UserValidatorProtocol

    func createUser(_ userData: UserData) -> Result<User, CreationError> {
        let validationResult = validator.validate(userData)
        guard validationResult.isValid else { return .failure(.validation) }

        let user = User(from: userData)
        return repository.save(user)
    }
}

struct PaymentProcessor {
    private let gateway: PaymentGateway
    private let logger: PaymentLogger

    func process(_ payment: Payment) -> Result<Receipt, PaymentError> {
        logger.logAttempt(payment)
        return gateway.process(payment)
    }
}

// ✅ GOOD: Composition for complex objects
struct OrderProcessor {
    private let validator: OrderValidator
    private let calculator: OrderCalculator

    // Additional dependencies injected through methods or composed objects
    func process(_ order: Order, using services: OrderServices) -> ProcessedOrder {
        let validationResult = validator.validate(order)
        let calculations = calculator.calculate(order)

        return services.fulfillment.process(order, with: calculations)
    }
}

// ❌ BAD: Too many instance variables
struct OrderProcessorBad {
    private let validator: OrderValidator      // 1
    private let calculator: OrderCalculator    // 2
    private let repository: OrderRepository    // 3 - TOO MANY!
    private let emailService: EmailService     // 4
    private let logger: Logger                 // 5
    private let metrics: MetricsCollector      // 6

    // Low cohesion, too many dependencies
}
```

