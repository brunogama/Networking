## **AUTOMATIC COMMAND ROUTING RULES**

### **Rule 1: Intercept All Shell Commands**
```typescript
// Automatically intercept any shell command attempt
when command_detected(cmd: string) {
    const classification = classifyCommand(cmd);
    const routingStrategy = determineRouting(classification);

    switch (routingStrategy) {
        case RoutingStrategy.MCP_DIRECT:
            return routeToMCP(cmd, getTimeoutForCommand(cmd));
        case RoutingStrategy.MCP_WITH_CONFIRMATION:
            return requestUserConfirmation(cmd).then(() => routeToMCP(cmd));
        case RoutingStrategy.SSH_FALLBACK:
            return routeToSSH(cmd);
        case RoutingStrategy.EXPLICIT_PERMISSION:
            return requestExplicitPermission(cmd);
    }
}
```

### **Rule 2: Timeout Management**
```typescript
function getTimeoutForCommand(command: string): number {
    const timeoutMap: Record<string, number> = {
        // Quick operations
        'ls': 5000, 'pwd': 5000, 'whoami': 5000,

        // File operations
        'find': 30000, 'grep': 30000, 'cat': 15000,

        // Git operations
        'git status': 10000, 'git log': 15000, 'git diff': 20000,
        'git add': 30000, 'git commit': 30000, 'git push': 60000,

        // Build operations
        'swift build': 120000, 'swift test': 180000,
        'xcodebuild': 300000, 'pod install': 180000,

        // Default
        'default': 30000
    };

    const baseCommand = command.split(' ')[0];
    return timeoutMap[baseCommand] || timeoutMap['default'];
}
```

### **Rule 3: Fallback Chain Implementation**
```typescript
async function executeWithFallback(command: string): Promise<CommandResult> {
    try {
        // Primary: DesktopCommander MCP
        return await mcp_MCP_DOCKER_execute_command(command, getTimeoutForCommand(command));
    } catch (mcpError) {
        logError('MCP execution failed', { command, error: mcpError });

        try {
            // Fallback: SSH localhost bypass
            return await executeViaSSH(command);
        } catch (sshError) {
            logError('SSH fallback failed', { command, error: sshError });

            // Emergency: Request explicit permission for direct execution
            const permission = await requestExplicitPermission(command);
            if (permission.granted) {
                return await executeDirectly(command);
            } else {
                throw new Error('Command execution denied by user');
            }
        }
    }
}
```

