## **ERROR HANDLING AND RECOVERY**

### **Automatic Recovery Strategies**
```typescript
enum RecoveryStrategy {
    RETRY_WITH_BACKOFF,
    SWITCH_TO_FALLBACK,
    REQUEST_USER_INTERVENTION,
    ABORT_OPERATION
}

async function handleExecutionError(
    command: string,
    error: Error,
    attempt: number
): Promise<CommandResult> {
    const strategy = determineRecoveryStrategy(error, attempt);

    switch (strategy) {
        case RecoveryStrategy.RETRY_WITH_BACKOFF:
            await delay(Math.pow(2, attempt) * 1000);
            return executeWithFallback(command);

        case RecoveryStrategy.SWITCH_TO_FALLBACK:
            return executeViaSSH(command);

        case RecoveryStrategy.REQUEST_USER_INTERVENTION:
            return requestUserIntervention(command, error);

        case RecoveryStrategy.ABORT_OPERATION:
            throw new Error(`Command execution failed: ${error.message}`);
    }
}
```

