{"identifier":{"url":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/ClientConfiguration","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"NetworkClient uses a declarative configuration system that allows you to set up clients with complex configurations in a readable, type-safe manner. The configuration system uses result builders to provide a clean syntax for specifying base URLs, timeouts, headers, authentication, middleware, and more.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Configuration components include:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Base Configuration","type":"text"}],"type":"strong"},{"type":"text","text":": URLs, timeouts, headers"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Authentication Setup","type":"text"}]},{"type":"text","text":": Various authentication methods"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Session Configuration","type":"text"}]},{"text":": URLSession customization","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Middleware Integration","type":"text"}],"type":"strong"},{"text":": Request\/response processing","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Security Settings","type":"text"}],"type":"strong"},{"type":"text","text":": SSL pinning, certificate validation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Performance Tuning"}]},{"type":"text","text":": Caching, connection limits, retry logic"}]}]}]},{"type":"heading","level":2,"text":"Basic Configuration","anchor":"Basic-Configuration"},{"type":"heading","level":3,"text":"Essential Settings","anchor":"Essential-Settings"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every NetworkClient needs basic configuration:"}]},{"syntax":"swift","type":"codeListing","code":["let client = NetworkClient {","    \/\/ Required: Base URL for all requests","    BaseURL(\"https:\/\/api.example.com\")","    ","    \/\/ Recommended: Default timeout","    DefaultTimeout(30.0)","    ","    \/\/ Optional: Default headers applied to all requests","    DefaultHeader(\"User-Agent\", \"MyApp\/1.0\")","    DefaultHeader(\"Accept\", \"application\/json\")","}"]},{"type":"heading","level":3,"text":"Multiple Base URLs","anchor":"Multiple-Base-URLs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle APIs with multiple endpoints:"}]},{"code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")          \/\/ Primary API","    FallbackURL(\"https:\/\/api-backup.example.com\") \/\/ Fallback if primary fails","    ","    DefaultTimeout(30.0)","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"Environment-Based-Configuration","text":"Environment-Based Configuration"},{"type":"paragraph","inlineContent":[{"text":"Configure clients for different environments:","type":"text"}]},{"code":["enum APIEnvironment {","    case development, staging, production","    ","    var baseURL: String {","        switch self {","        case .development: return \"https:\/\/dev-api.example.com\"","        case .staging: return \"https:\/\/staging-api.example.com\"","        case .production: return \"https:\/\/api.example.com\"","        }","    }","    ","    var timeout: TimeInterval {","        switch self {","        case .development: return 60.0  \/\/ Longer for debugging","        case .staging: return 45.0      \/\/ Moderate for testing","        case .production: return 30.0   \/\/ Optimized for production","        }","    }","}","","let environment = APIEnvironment.production","","let client = NetworkClient {","    BaseURL(environment.baseURL)","    DefaultTimeout(environment.timeout)","    ","    \/\/ Environment-specific headers","    DefaultHeader(\"X-Environment\", \"\\(environment)\")","    DefaultHeader(\"X-Client-Version\", Bundle.main.version)","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"URLSession Configuration","anchor":"URLSession-Configuration","type":"heading"},{"anchor":"Custom-Session-Settings","level":3,"text":"Custom Session Settings","type":"heading"},{"inlineContent":[{"type":"text","text":"Customize the underlying URLSession:"}],"type":"paragraph"},{"syntax":"swift","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    Session {","        \/\/ Network access control","        AllowsCellularAccess(true)","        AllowsExpensiveNetworkAccess(false)","        AllowsConstrainedNetworkAccess(true)","        ","        \/\/ Timeout intervals","        TimeoutIntervalForRequest(60.0)","        TimeoutIntervalForResource(300.0)","        ","        \/\/ Connection limits","        HTTPMaximumConnectionsPerHost(4)","        HTTPShouldUsePipelining(false)","        ","        \/\/ Cookie and credential handling","        HTTPCookieAcceptPolicy(.always)","        HTTPShouldSetCookies(true)","        ","        \/\/ Cache behavior","        RequestCachePolicy(.useProtocolCachePolicy)","    }","}"],"type":"codeListing"},{"type":"heading","anchor":"Proxy-Configuration","level":3,"text":"Proxy Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure proxy settings:"}]},{"code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    Session {","        \/\/ HTTP proxy","        ProxyConfiguration {","            HTTPProxy(host: \"proxy.company.com\", port: 8080)","            HTTPSProxy(host: \"secure-proxy.company.com\", port: 8443)","            ProxyCredentials(username: \"user\", password: \"pass\")","        }","        ","        \/\/ Bypass proxy for certain hosts","        ProxyBypass([\"localhost\", \"127.0.0.1\", \"*.local\"])","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Authentication-Configuration","level":2,"text":"Authentication Configuration"},{"type":"heading","anchor":"Bearer-Token-Authentication","level":3,"text":"Bearer Token Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Simple token-based authentication:"}]},{"code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    \/\/ Static token","    BearerToken(\"your-static-token\")","    ","    \/\/ Or dynamic token","    DynamicBearerToken {","        await AuthService.shared.getCurrentToken()","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Basic Authentication","anchor":"Basic-Authentication"},{"type":"paragraph","inlineContent":[{"text":"Username\/password authentication:","type":"text"}]},{"type":"codeListing","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    BasicAuth(username: \"api-user\", password: \"secret-password\")","    ","    \/\/ Or with credentials from keychain","    BasicAuth {","        let credentials = try await Keychain.getCredentials(for: \"api.example.com\")","        return (credentials.username, credentials.password)","    }","}"],"syntax":"swift"},{"text":"API Key Authentication","anchor":"API-Key-Authentication","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"API key in headers or query parameters:"}],"type":"paragraph"},{"syntax":"swift","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    \/\/ API key in header","    APIKey(header: \"X-API-Key\", key: \"your-api-key\")","    ","    \/\/ API key in query parameter","    APIKey(queryParam: \"api_key\", key: \"your-api-key\")","    ","    \/\/ Multiple API keys","    APIKey(header: \"X-Primary-Key\", key: primaryKey)","    APIKey(header: \"X-Secondary-Key\", key: secondaryKey)","}"],"type":"codeListing"},{"level":3,"type":"heading","text":"Custom Authentication","anchor":"Custom-Authentication"},{"inlineContent":[{"text":"Implement complex authentication schemes:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    CustomAuth { request in","        var modifiedRequest = request","        ","        \/\/ Generate signature","        let timestamp = String(Int(Date().timeIntervalSince1970))","        let signature = generateHMACSignature(","            method: request.method.rawValue,","            path: request.url.path,","            timestamp: timestamp,","            body: request.body,","            secretKey: \"your-secret-key\"","        )","        ","        \/\/ Add authentication headers","        modifiedRequest.headers[\"X-Timestamp\"] = timestamp","        modifiedRequest.headers[\"X-Signature\"] = signature","        modifiedRequest.headers[\"X-API-Key\"] = \"your-api-key\"","        ","        return modifiedRequest","    }","}"],"syntax":"swift"},{"text":"Security Configuration","anchor":"Security-Configuration","type":"heading","level":2},{"type":"heading","level":3,"anchor":"SSL-Certificate-Pinning","text":"SSL Certificate Pinning"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pin SSL certificates for enhanced security:"}]},{"syntax":"swift","type":"codeListing","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    EnableSecurity {","        \/\/ SHA-256 certificate fingerprints","        CertificatePinning(sha256Hashes: [","            \"E9CZ9INDbd+2eRQozYqqbQ2yXLVKB9+xcprMF+44U1g=\",","            \"LvRiGEjRqfzurezaWuj8Wie2gyHMrW5Q06LspMnox7A=\"","        ])","        ","        \/\/ Minimum TLS version","        MinTLSVersion(.v1_2)","        ","        \/\/ Certificate validation callback","        CustomCertificateValidation { challenge, completionHandler in","            \/\/ Custom certificate validation logic","            let trust = challenge.protectionSpace.serverTrust","            let result = SecTrustEvaluateWithError(trust!, nil)","            completionHandler(result ? .useCredential : .cancelAuthenticationChallenge, nil)","        }","    }","}"]},{"text":"Security Headers","anchor":"Security-Headers","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add security-related headers:"}]},{"type":"codeListing","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    \/\/ Security headers","    DefaultHeader(\"Strict-Transport-Security\", \"max-age=31536000\")","    DefaultHeader(\"X-Frame-Options\", \"DENY\")","    DefaultHeader(\"X-Content-Type-Options\", \"nosniff\")","    DefaultHeader(\"Referrer-Policy\", \"strict-origin-when-cross-origin\")","}"],"syntax":"swift"},{"level":2,"anchor":"Middleware-Configuration","type":"heading","text":"Middleware Configuration"},{"level":3,"anchor":"Built-in-Middleware","type":"heading","text":"Built-in Middleware"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure common middleware:"}]},{"code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    \/\/ Retry middleware","    EnableRetry {","        MaxAttempts(3)","        BackoffStrategy(.exponential(multiplier: 2.0))","        RetryCondition(.networkErrors)","        RetryCondition(.serverErrors)","        RetryCondition { error in","            \/\/ Custom retry logic","            return error.isTransientError","        }","    }","    ","    \/\/ Caching middleware","    EnableCaching {","        Policy(.standard)","        Storage(.hybrid(","            memorySize: .megabytes(50),","            diskSize: .megabytes(500)","        ))","        Duration(.minutes(15))","        ","        \/\/ Custom cache key generation","        KeyGenerator { request in","            return \"\\(request.method.rawValue):\\(request.url.absoluteString)\"","        }","    }","    ","    \/\/ Logging middleware","    EnableLogging {","        Level(.info)","        LogRequests(true)","        LogResponses(true)","        LogHeaders(true)","        LogBodies(false)","        ","        \/\/ Custom logger","        Logger(OSLog(subsystem: \"com.example.app\", category: \"networking\"))","    }","    ","    \/\/ Observability middleware","    EnableObservability {","        CollectMetrics(true)","        TrackTiming(true)","        ","        \/\/ Custom metrics handler","        MetricsHandler { metrics in","            await AnalyticsService.shared.record(metrics)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Custom-Middleware","type":"heading","level":3,"text":"Custom Middleware"},{"type":"paragraph","inlineContent":[{"text":"Add custom middleware to the pipeline:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    \/\/ Custom request middleware","    Middleware(APIVersionMiddleware(version: \"v2\"))","    Middleware(RequestIDMiddleware())","    Middleware(RateLimitingMiddleware(requestsPerSecond: 10))","    ","    \/\/ Custom response middleware","    Middleware(ResponseTimingMiddleware())","    Middleware(ErrorTrackingMiddleware())","    ","    \/\/ Custom error middleware","    Middleware(TokenRefreshMiddleware(authService: authService))","}"]},{"anchor":"Performance-Configuration","type":"heading","level":2,"text":"Performance Configuration"},{"anchor":"Connection-Management","type":"heading","level":3,"text":"Connection Management"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Optimize connection handling:"}]},{"type":"codeListing","syntax":"swift","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    Session {","        \/\/ Connection pooling","        HTTPMaximumConnectionsPerHost(6)","        HTTPShouldUsePipelining(true)","        ","        \/\/ Keep-alive settings","        HTTPAdditionalHeaders([","            \"Connection\": \"keep-alive\",","            \"Keep-Alive\": \"timeout=30, max=100\"","        ])","        ","        \/\/ Connection timeout","        TimeoutIntervalForRequest(30.0)","        TimeoutIntervalForResource(300.0)","    }","    ","    \/\/ Request coalescing for duplicate requests","    EnableRequestCoalescing()","    ","    \/\/ Connection prewarming","    PrewarmConnections(count: 2)","}"]},{"level":3,"type":"heading","anchor":"Caching-Strategy","text":"Caching Strategy"},{"type":"paragraph","inlineContent":[{"text":"Configure intelligent caching:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    EnableCaching {","        \/\/ Multi-tier caching","        Storage(.hybrid(","            memorySize: .megabytes(50),    \/\/ Fast memory cache","            diskSize: .megabytes(500)      \/\/ Persistent disk cache","        ))","        ","        \/\/ Cache policies by endpoint","        PolicyForPath(\"\/api\/static\/**\", policy: .aggressive)","        PolicyForPath(\"\/api\/user\/**\", policy: .standard)","        PolicyForPath(\"\/api\/realtime\/**\", policy: .networkFirst)","        ","        \/\/ Cache validation","        EnableETagValidation(true)","        EnableLastModifiedValidation(true)","        ","        \/\/ Cache invalidation","        InvalidateOn(.backgroundAppRefresh)","        InvalidateOn(.significantTimeChange)","    }","}"]},{"text":"Advanced Configuration Patterns","anchor":"Advanced-Configuration-Patterns","level":2,"type":"heading"},{"text":"Configuration Builders","anchor":"Configuration-Builders","type":"heading","level":3},{"inlineContent":[{"text":"Create reusable configuration patterns:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct APIClientConfiguration {","    static func development(apiKey: String) -> NetworkClientConfiguration {","        return {","            BaseURL(\"https:\/\/dev-api.example.com\")","            DefaultTimeout(60.0)","            APIKey(header: \"X-API-Key\", key: apiKey)","            ","            EnableLogging {","                Level(.debug)","                LogRequests(true)","                LogResponses(true)","                LogHeaders(true)","                LogBodies(true)","            }","            ","            EnableRetry {","                MaxAttempts(1) \/\/ No retry in development","            }","        }","    }","    ","    static func production(apiKey: String) -> NetworkClientConfiguration {","        return {","            BaseURL(\"https:\/\/api.example.com\")","            FallbackURL(\"https:\/\/api-backup.example.com\")","            DefaultTimeout(30.0)","            APIKey(header: \"X-API-Key\", key: apiKey)","            ","            EnableSecurity {","                CertificatePinning(sha256Hashes: productionCertHashes)","                MinTLSVersion(.v1_2)","            }","            ","            EnableRetry {","                MaxAttempts(3)","                BackoffStrategy(.exponential(multiplier: 2.0))","            }","            ","            EnableCaching {","                Policy(.standard)","                Duration(.minutes(15))","                Storage(.hybrid(memorySize: .megabytes(50), diskSize: .megabytes(200)))","            }","            ","            EnableObservability {","                CollectMetrics(true)","                TrackTiming(true)","            }","        }","    }","}","","\/\/ Usage","let client = NetworkClient(APIClientConfiguration.production(apiKey: \"prod-key\"))"]},{"anchor":"Configuration-Composition","type":"heading","level":3,"text":"Configuration Composition"},{"inlineContent":[{"type":"text","text":"Compose configurations from multiple sources:"}],"type":"paragraph"},{"type":"codeListing","code":["@NetworkClientBuilder","func baseConfiguration() -> NetworkClientConfiguration {","    DefaultTimeout(30.0)","    DefaultHeader(\"User-Agent\", \"MyApp\/\\(Bundle.main.version)\")","    DefaultHeader(\"Accept\", \"application\/json\")","}","","@NetworkClientBuilder","func authenticationConfiguration(token: String) -> NetworkClientConfiguration {","    BearerToken(token)","    Middleware(TokenRefreshMiddleware())","}","","@NetworkClientBuilder","func performanceConfiguration() -> NetworkClientConfiguration {","    EnableCaching {","        Policy(.standard)","        Duration(.minutes(15))","    }","    ","    EnableRetry {","        MaxAttempts(3)","        BackoffStrategy(.exponential(multiplier: 2.0))","    }","    ","    Session {","        HTTPMaximumConnectionsPerHost(4)","        AllowsExpensiveNetworkAccess(false)","    }","}","","\/\/ Compose configurations","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    baseConfiguration()","    authenticationConfiguration(token: userToken)","    performanceConfiguration()","}"],"syntax":"swift"},{"text":"Dynamic Configuration","level":3,"anchor":"Dynamic-Configuration","type":"heading"},{"inlineContent":[{"type":"text","text":"Update configuration at runtime:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class DynamicNetworkClient {","    private var client: NetworkClient","    ","    init(baseURL: String) {","        self.client = NetworkClient {","            BaseURL(baseURL)","            DefaultTimeout(30.0)","        }","    }","    ","    func updateAuthentication(token: String) {","        client = NetworkClient {","            BaseURL(client.baseURL)","            DefaultTimeout(client.defaultTimeout)","            BearerToken(token)","            ","            \/\/ Preserve existing middleware","            client.middleware.forEach { middleware in","                Middleware(middleware)","            }","        }","    }","    ","    func updateEnvironment(_ environment: APIEnvironment) {","        client = NetworkClient {","            BaseURL(environment.baseURL)","            DefaultTimeout(environment.timeout)","            ","            \/\/ Environment-specific configuration","            switch environment {","            case .development:","                EnableLogging { Level(.debug) }","            case .production:","                EnableObservability { CollectMetrics(true) }","            default:","                break","            }","        }","    }","}"]},{"anchor":"Configuration-Validation","type":"heading","level":2,"text":"Configuration Validation"},{"text":"Runtime Validation","level":3,"anchor":"Runtime-Validation","type":"heading"},{"inlineContent":[{"type":"text","text":"Validate configuration at client creation:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ValidatedNetworkClient {","    let client: NetworkClient","    ","    init(@NetworkClientBuilder configuration: () -> NetworkClientConfiguration) throws {","        let config = configuration()","        ","        \/\/ Validate required configuration","        guard !config.baseURL.isEmpty else {","            throw ConfigurationError.missingBaseURL","        }","        ","        guard config.defaultTimeout > 0 else {","            throw ConfigurationError.invalidTimeout","        }","        ","        \/\/ Validate security configuration","        if config.certificatePinning.isEnabled && config.baseURL.hasPrefix(\"http:\") {","            throw ConfigurationError.certificatePinningWithHTTP","        }","        ","        self.client = NetworkClient(config)","    }","}"],"type":"codeListing"},{"level":3,"type":"heading","text":"Configuration Testing","anchor":"Configuration-Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test different configuration scenarios:"}]},{"code":["@Test func testDevelopmentConfiguration() throws {","    let client = NetworkClient(APIClientConfiguration.development(apiKey: \"test-key\"))","    ","    #expect(client.baseURL == \"https:\/\/dev-api.example.com\")","    #expect(client.defaultTimeout == 60.0)","    #expect(client.loggingLevel == .debug)","    #expect(client.maxRetryAttempts == 1)","}","","@Test func testProductionConfiguration() throws {","    let client = NetworkClient(APIClientConfiguration.production(apiKey: \"prod-key\"))","    ","    #expect(client.baseURL == \"https:\/\/api.example.com\")","    #expect(client.defaultTimeout == 30.0)","    #expect(client.certificatePinning.isEnabled)","    #expect(client.maxRetryAttempts == 3)","}","","@Test func testConfigurationComposition() throws {","    let client = NetworkClient {","        BaseURL(\"https:\/\/api.example.com\")","        baseConfiguration()","        authenticationConfiguration(token: \"test-token\")","        performanceConfiguration()","    }","    ","    #expect(client.defaultHeaders[\"User-Agent\"]?.starts(with: \"MyApp\/\") == true)","    #expect(client.authenticationHeaders[\"Authorization\"] == \"Bearer test-token\")","    #expect(client.caching.isEnabled)","    #expect(client.retry.isEnabled)","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Best Practices","anchor":"Best-Practices","level":2},{"level":3,"text":"Configuration Organization","anchor":"Configuration-Organization","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Structure by concern:","type":"text"}]}]},{"syntax":"swift","code":["extension NetworkClient {","    static func apiClient(environment: Environment) -> NetworkClient {","        NetworkClient {","            \/\/ Base configuration","            baseConfiguration(for: environment)","            ","            \/\/ Authentication","            authenticationConfiguration(for: environment)","            ","            \/\/ Security","            securityConfiguration(for: environment)","            ","            \/\/ Performance","            performanceConfiguration(for: environment)","            ","            \/\/ Observability","            observabilityConfiguration(for: environment)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"inlineContent":[{"text":"Environment-specific patterns:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use different timeouts for development vs production","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable verbose logging only in development"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Apply certificate pinning only in production"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use different retry strategies per environment"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Security considerations:"}]}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Never hardcode secrets in configuration","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Use secure storage for sensitive configuration"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Validate SSL certificates in production"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Apply appropriate timeout values to prevent hanging","type":"text"}],"type":"paragraph"}]}]}]}],"hierarchy":{"paths":[["doc:\/\/com.brunogama.networking\/documentation\/Networking"]]},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/com.brunogama.networking\/documentation\/Networking\/NetworkClient","doc:\/\/com.brunogama.networking\/documentation\/Networking\/MiddlewareOverview"]}],"sections":[],"kind":"article","metadata":{"title":"Client Configuration","roleHeading":"Article","role":"article"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Comprehensive configuration options for NetworkClient using the declarative configuration DSL.","type":"text"}],"references":{"doc://com.brunogama.networking/documentation/Networking":{"title":"Networking","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking","kind":"article","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/networking"},"doc://com.brunogama.networking/documentation/Networking/MiddlewareOverview":{"url":"\/documentation\/networking\/middlewareoverview","type":"topic","abstract":[{"text":"Extensible request and response processing pipeline for cross-cutting concerns like authentication, caching, retry logic, and observability.","type":"text"}],"kind":"article","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/MiddlewareOverview","title":"Middleware Overview","role":"article"},"doc://com.brunogama.networking/documentation/Networking/NetworkClient":{"title":"NetworkClient","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/NetworkClient","kind":"article","abstract":[{"type":"text","text":"The primary HTTP client implementation with comprehensive middleware support and declarative configuration."}],"type":"topic","role":"article","url":"\/documentation\/networking\/networkclient"}}}