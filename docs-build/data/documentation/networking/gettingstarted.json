{"sections":[],"identifier":{"url":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/GettingStarted","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.brunogama.networking\/documentation\/Networking"]]},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Getting Started"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The Networking framework provides a modern, Swift 6 compliant HTTP client with a declarative API, middleware support, and advanced features like SSL pinning, caching, and progress tracking."}],"type":"paragraph"},{"anchor":"Installation","level":2,"text":"Installation","type":"heading"},{"anchor":"Swift-Package-Manager","level":3,"text":"Swift Package Manager","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the Networking framework to your "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/brunogama\/Networking.git\", from: \"1.0.0\")","]"]},{"inlineContent":[{"type":"text","text":"Or add it through Xcode:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"File → Add Package Dependencies"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Enter "},{"code":"https:\/\/github.com\/brunogama\/Networking.git","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select version and add to your target","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Basic-Setup","level":2,"text":"Basic Setup","type":"heading"},{"anchor":"Creating-Your-First-Client","level":3,"text":"Creating Your First Client","type":"heading"},{"inlineContent":[{"text":"The simplest way to create a networking client:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Networking","","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    DefaultTimeout(30.0)","    DefaultHeader(\"User-Agent\", \"MyApp\/1.0\")","}"]},{"anchor":"Making-Your-First-Request","level":3,"text":"Making Your First Request","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Execute a simple GET request:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let response = try await client.execute {","    GET(\"\/users\/123\")","    Header(\"Accept\", \"application\/json\")","}","","print(\"Status: \\(response.status)\")","print(\"Data: \\(String(data: response.body ?? Data(), encoding: .utf8) ?? \"No data\")\")"]},{"type":"heading","level":3,"text":"Working with JSON","anchor":"Working-with-JSON"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Decode JSON responses directly:"}]},{"type":"codeListing","syntax":"swift","code":["struct User: Codable {","    let id: Int","    let name: String","    let email: String","}","","let response = try await client.execute {","    GET(\"\/users\/123\")","    Header(\"Accept\", \"application\/json\")","}","","let user: User = try response.decode(User.self)","print(\"User: \\(user.name)\")"]},{"type":"heading","level":2,"text":"Key Concepts","anchor":"Key-Concepts"},{"type":"heading","level":3,"text":"Declarative Configuration","anchor":"Declarative-Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The framework uses result builders to provide a clean, readable syntax:"}]},{"type":"codeListing","syntax":"swift","code":["let client = NetworkClient {","    \/\/ Base configuration","    BaseURL(\"https:\/\/api.example.com\")","    DefaultTimeout(30.0)","    ","    \/\/ Authentication","    BearerToken(\"your-token-here\")","    ","    \/\/ Headers","    DefaultHeader(\"User-Agent\", \"MyApp\/1.0\")","    DefaultHeader(\"Accept\", \"application\/json\")","    ","    \/\/ Enable middleware","    EnableRetry()","    EnableLogging()","    EnableCaching()","}"]},{"type":"heading","level":3,"text":"Request Building","anchor":"Request-Building"},{"type":"paragraph","inlineContent":[{"text":"Build requests using the same declarative syntax:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let request = HTTPRequest {","    POST(\"\/api\/users\")","    Header(\"Content-Type\", \"application\/json\")","    JSONBody(newUser)","    Timeout(15.0)","}","","let response = try await client.execute(request)"]},{"type":"heading","level":3,"text":"Async\/Await Support","anchor":"AsyncAwait-Support"},{"type":"paragraph","inlineContent":[{"text":"All networking operations are async and built with structured concurrency:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Sequential requests","let user = try await client.execute { GET(\"\/user\/123\") }","let posts = try await client.execute { GET(\"\/user\/123\/posts\") }","","\/\/ Concurrent requests","async let userTask = client.execute { GET(\"\/user\/123\") }","async let postsTask = client.execute { GET(\"\/user\/123\/posts\") }","","let (user, posts) = try await (userTask, postsTask)"]},{"type":"heading","level":2,"text":"Next Steps","anchor":"Next-Steps"},{"type":"paragraph","inlineContent":[{"text":"Now that you have the basics, explore more advanced features:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/ClientConfiguration"}],"type":"strong"},{"type":"text","text":": Learn about comprehensive client configuration options"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/MiddlewareOverview","type":"reference"}],"type":"strong"},{"type":"text","text":": Understand the powerful middleware system"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"doc:MacroGeneration","type":"text"}]},{"type":"text","text":": Generate type-safe API clients automatically"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"doc:SecurityFeatures"}],"type":"strong"},{"text":": Implement SSL pinning and secure authentication","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"doc:CachingOverview","type":"text"}],"type":"strong"},{"text":": Add intelligent caching to your requests","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Common Patterns","anchor":"Common-Patterns"},{"type":"heading","level":3,"text":"Error Handling","anchor":"Error-Handling"},{"type":"codeListing","code":["do {","    let response = try await client.execute {","        GET(\"\/api\/data\")","    }","    \/\/ Handle success","} catch let error as HTTPError {","    switch error.category {","    case .network(.noConnection):","        \/\/ Handle network issues","        print(\"No internet connection\")","    case .http(.unauthorized):","        \/\/ Handle auth issues","        print(\"Please log in again\")","    default:","        \/\/ Handle other errors","        print(\"Request failed: \\(error.userFriendlyDescription)\")","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"Request Retry","anchor":"Request-Retry"},{"type":"codeListing","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    EnableRetry {","        MaxAttempts(3)","        BackoffStrategy(.exponential(multiplier: 2.0))","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"Response Caching","anchor":"Response-Caching"},{"type":"codeListing","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    EnableCaching {","        Policy(.standard)","        Storage(.memory(maxSize: .megabytes(50)))","        Duration(.minutes(15))","    }","}"],"syntax":"swift"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Learn how to integrate and use the Networking framework in your Swift applications.","type":"text"}],"references":{"doc://com.brunogama.networking/documentation/Networking/ClientConfiguration":{"title":"Client Configuration","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/ClientConfiguration","kind":"article","abstract":[{"text":"Comprehensive configuration options for NetworkClient using the declarative configuration DSL.","type":"text"}],"type":"topic","role":"article","url":"\/documentation\/networking\/clientconfiguration"},"doc://com.brunogama.networking/documentation/Networking":{"title":"Networking","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking","kind":"article","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/networking"},"doc://com.brunogama.networking/documentation/Networking/MiddlewareOverview":{"url":"\/documentation\/networking\/middlewareoverview","type":"topic","abstract":[{"text":"Extensible request and response processing pipeline for cross-cutting concerns like authentication, caching, retry logic, and observability.","type":"text"}],"kind":"article","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/MiddlewareOverview","title":"Middleware Overview","role":"article"}}}