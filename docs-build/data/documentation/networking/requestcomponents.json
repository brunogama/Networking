{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestBuilding","doc:\/\/com.brunogama.networking\/documentation\/Networking\/HTTPMethods","doc:\/\/com.brunogama.networking\/documentation\/Networking\/ConditionalRequests"],"anchor":"Related-Documentation"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.brunogama.networking\/documentation\/Networking"]]},"sections":[],"metadata":{"roleHeading":"Article","role":"article","title":"Request Components"},"kind":"article","abstract":[{"text":"Modular building blocks for constructing HTTP requests with the RequestComponent protocol.","type":"text"}],"identifier":{"url":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestComponents","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Request components are the foundation of the declarative request building system. Each component represents a specific aspect of an HTTP request and can be combined to create complex requests in a readable, type-safe manner."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The RequestComponent system provides:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modular Architecture"}]},{"type":"text","text":": Each component handles a specific request aspect"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Composability","type":"text"}],"type":"strong"},{"text":": Components can be mixed and matched freely","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Type Safety","type":"text"}],"type":"strong"},{"type":"text","text":": Compile-time validation of component usage"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Extensibility"}],"type":"strong"},{"type":"text","text":": Create custom components for specialized needs"}]}]}]},{"type":"heading","level":2,"text":"RequestComponent Protocol","anchor":"RequestComponent-Protocol"},{"type":"heading","level":3,"text":"Core Protocol","anchor":"Core-Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All request components conform to the "},{"type":"codeVoice","code":"RequestComponent"},{"type":"text","text":" protocol:"}]},{"syntax":"swift","code":["\/\/\/ Protocol for components that modify HTTP requests","public protocol RequestComponent {","    \/\/\/ Apply this component's modifications to the request","    \/\/\/ - Parameter request: The request to modify","    \/\/\/ - Throws: Any errors that occur during application","    func apply(to request: inout HTTPRequest) throws","}"],"type":"codeListing"},{"text":"Component Lifecycle","anchor":"Component-Lifecycle","type":"heading","level":3},{"inlineContent":[{"text":"Components are applied in the order they appear in the request builder:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let request = HTTPRequest {","    \/\/ 1. Method and path","    POST(\"\/api\/users\")","    ","    \/\/ 2. Headers (applied in order)","    Header(\"Accept\", \"application\/json\")","    ContentType(.json)","    ","    \/\/ 3. Authentication","    BearerAuth(token)","    ","    \/\/ 4. Body content","    JSONBody(user)","    ","    \/\/ 5. Request configuration","    Timeout(30.0)","}"],"type":"codeListing"},{"text":"Built-in Components","anchor":"Built-in-Components","type":"heading","level":2},{"text":"HTTP Method Components","anchor":"HTTP-Method-Components","type":"heading","level":3},{"inlineContent":[{"text":"Components that set the HTTP method and path:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Standard HTTP methods","GET(\"\/api\/users\")","POST(\"\/api\/users\")","PUT(\"\/api\/users\/123\")","PATCH(\"\/api\/users\/123\")","DELETE(\"\/api\/users\/123\")","HEAD(\"\/api\/users\")","OPTIONS(\"\/api\/users\")","","\/\/ Custom method","Method(\"PROPFIND\")","Path(\"\/webdav\/collection\")"],"type":"codeListing"},{"text":"Header Components","anchor":"Header-Components","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Components for managing request headers:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Generic header","Header(\"Accept\", \"application\/json\")","Header(\"X-Client-Version\", \"1.0\")","","\/\/ Specialized header components","ContentType(.json)              \/\/ Content-Type: application\/json","AcceptHeader(.xml)              \/\/ Accept: application\/xml","UserAgent(\"MyApp\/1.0\")         \/\/ User-Agent: MyApp\/1.0","CacheControl(\"no-cache\")       \/\/ Cache-Control: no-cache"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Content Type Shortcuts:","type":"text"}]}],"type":"paragraph"},{"syntax":"swift","code":["ContentType(.json)             \/\/ application\/json","ContentType(.xml)              \/\/ application\/xml","ContentType(.formURLEncoded)   \/\/ application\/x-www-form-urlencoded","ContentType(.plainText)        \/\/ text\/plain","ContentType(.html)             \/\/ text\/html","ContentType(.octetStream)      \/\/ application\/octet-stream"],"type":"codeListing"},{"text":"Authentication Components","anchor":"Authentication-Components","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Components for various authentication methods:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Bearer token authentication","BearerAuth(\"your-token-here\")","","\/\/ Basic authentication","RequestBasicAuth(username: \"user\", password: \"pass\")","","\/\/ API key authentication","APIKey(\"X-API-Key\", \"your-api-key\")","APIKey(\"Authorization\", \"Bearer \\(token)\")","","\/\/ Custom authentication","CustomAuth { request in","    var modifiedRequest = request","    modifiedRequest.headers[\"X-Custom-Auth\"] = computeSignature(request)","    return modifiedRequest","}"],"type":"codeListing"},{"text":"Body Components","anchor":"Body-Components","type":"heading","level":3},{"inlineContent":[{"text":"Components for request body content:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ JSON body (automatically sets Content-Type)","struct User: Codable {","    let name: String","    let email: String","}","JSONBody(User(name: \"John\", email: \"john@example.com\"))","","\/\/ Raw data body","DataBody(imageData)","","\/\/ Form-encoded body (automatically sets Content-Type)  ","FormBody([","    \"username\": \"john_doe\",","    \"password\": \"secret123\",","    \"remember_me\": \"true\"","])","","\/\/ String body","StringBody(\"Plain text content\")","","\/\/ Empty body (explicit)","EmptyBody()"],"type":"codeListing"},{"text":"Query Parameter Components","anchor":"Query-Parameter-Components","type":"heading","level":3},{"inlineContent":[{"text":"Components for URL query parameters:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Individual parameters","QueryParam(\"page\", \"1\")","QueryParam(\"limit\", \"25\")","QueryParam(\"sort\", \"name\")","","\/\/ Multiple parameters at once","QueryParams([","    \"filter\": \"active\",","    \"include\": \"profile\",","    \"expand\": \"permissions\"","])","","\/\/ Array parameters","QueryParamArray(\"tags\", [\"swift\", \"networking\", \"ios\"])","\/\/ Results in: ?tags=swift&tags=networking&tags=ios","","\/\/ URL-encoded parameters","QueryParam(\"search\", \"hello world\") \/\/ Automatically URL-encoded"],"type":"codeListing"},{"text":"Configuration Components","anchor":"Configuration-Components","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Components for request-level configuration:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Request timeout","RequestTimeout(60.0)          \/\/ 60 seconds","RequestTimeout(.minutes(5))   \/\/ 5 minutes","","\/\/ Base URL override","RequestBaseURL(\"https:\/\/staging-api.example.com\")","","\/\/ Cache policy","CachePolicy(.reloadIgnoringLocalCacheData)","CachePolicy(.returnCacheDataDontLoad)","","\/\/ Network service type","NetworkServiceType(.video)    \/\/ Optimize for video streaming","NetworkServiceType(.background) \/\/ Background processing"],"syntax":"swift"},{"text":"Creating Custom Components","level":2,"anchor":"Creating-Custom-Components","type":"heading"},{"text":"Simple Custom Components","level":3,"anchor":"Simple-Custom-Components","type":"heading"},{"inlineContent":[{"type":"text","text":"Create components for common patterns:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ API version header component","struct APIVersion: RequestComponent {","    let version: String","    ","    func apply(to request: inout HTTPRequest) throws {","        request.headers[\"X-API-Version\"] = version","    }","}","","\/\/ Usage","let request = HTTPRequest {","    GET(\"\/api\/users\")","    APIVersion(\"v2\")","}"],"syntax":"swift"},{"text":"Parameterized Components","level":3,"anchor":"Parameterized-Components","type":"heading"},{"inlineContent":[{"type":"text","text":"Components with configuration options:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Retry policy component","struct RetryPolicy: RequestComponent {","    let maxAttempts: Int","    let backoffMultiplier: Double","    ","    func apply(to request: inout HTTPRequest) throws {","        request.headers[\"X-Max-Retries\"] = \"\\(maxAttempts)\"","        request.headers[\"X-Backoff-Multiplier\"] = \"\\(backoffMultiplier)\"","    }","}","","\/\/ Usage","let request = HTTPRequest {","    GET(\"\/api\/flaky-endpoint\")","    RetryPolicy(maxAttempts: 3, backoffMultiplier: 2.0)","}"],"syntax":"swift"},{"text":"Conditional Components","level":3,"anchor":"Conditional-Components","type":"heading"},{"inlineContent":[{"text":"Components that apply based on conditions:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Conditional authentication","struct ConditionalAuth: RequestComponent {","    let token: String?","    ","    func apply(to request: inout HTTPRequest) throws {","        if let token = token {","            request.headers[\"Authorization\"] = \"Bearer \\(token)\"","        }","    }","}","","\/\/ Debug headers (only in debug builds)","struct DebugHeaders: RequestComponent {","    let buildInfo: String","    ","    func apply(to request: inout HTTPRequest) throws {","        #if DEBUG","        request.headers[\"X-Build-Info\"] = buildInfo","        request.headers[\"X-Debug-Mode\"] = \"true\"","        #endif","    }","}"],"syntax":"swift"},{"text":"Validation Components","level":3,"anchor":"Validation-Components","type":"heading"},{"inlineContent":[{"type":"text","text":"Components that validate request properties:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Path validation component","struct ValidatedPath: RequestComponent {","    let path: String","    ","    init(_ path: String) throws {","        guard path.hasPrefix(\"\/\") else {","            throw RequestError.invalidPath(\"Path must start with \/\")","        }","        guard !path.contains(\"..\") else {","            throw RequestError.invalidPath(\"Path cannot contain '..'\")","        }","        self.path = path","    }","    ","    func apply(to request: inout HTTPRequest) throws {","        \/\/ Apply validated path","        if var components = URLComponents(url: request.url, resolvingAgainstBaseURL: false) {","            components.path = path","            if let newURL = components.url {","                request = HTTPRequest(","                    method: request.method,","                    url: newURL,","                    headers: request.headers,","                    body: request.body,","                    timeout: request.timeout","                )","            }","        }","    }","}"],"syntax":"swift"},{"level":3,"anchor":"Complex-Custom-Components","type":"heading","text":"Complex Custom Components"},{"inlineContent":[{"text":"Components that perform multiple operations:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Complete request signing component","struct RequestSigner: RequestComponent {","    let apiKey: String","    let secretKey: String","    ","    func apply(to request: inout HTTPRequest) throws {","        let timestamp = String(Int(Date().timeIntervalSince1970))","        let bodyHash = SHA256.hash(data: request.body ?? Data())","        ","        \/\/ Create signature string","        let signatureString = [","            request.method.rawValue,","            request.url.path,","            timestamp,","            bodyHash.hexString","        ].joined(separator: \"\\n\")","        ","        \/\/ Generate HMAC signature","        let signature = HMAC<SHA256>.authenticationCode(","            for: signatureString.data(using: .utf8)!,","            using: SymmetricKey(data: secretKey.data(using: .utf8)!)","        )","        ","        \/\/ Apply headers","        request.headers[\"X-API-Key\"] = apiKey","        request.headers[\"X-Timestamp\"] = timestamp","        request.headers[\"X-Signature\"] = signature.hexString","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Component-Composition","type":"heading","text":"Component Composition"},{"level":3,"anchor":"Combining-Components","type":"heading","text":"Combining Components"},{"inlineContent":[{"type":"text","text":"Create reusable component groups:"}],"type":"paragraph"},{"code":["\/\/ Common API request components","@RequestBuilder","func commonAPIComponents(token: String) -> [RequestComponent] {","    Header(\"Accept\", \"application\/json\")","    Header(\"User-Agent\", \"MyApp\/1.0\")","    BearerAuth(token)","    APIVersion(\"v2\")","    RequestTimeout(30.0)","}","","\/\/ Usage","let request = HTTPRequest {","    GET(\"\/api\/users\")","    commonAPIComponents(token: userToken)","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Component-Factory-Functions","type":"heading","text":"Component Factory Functions"},{"inlineContent":[{"text":"Create factory functions for complex components:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Pagination components factory","func paginationComponents(page: Int, limit: Int = 25) -> [RequestComponent] {","    return [","        QueryParam(\"page\", \"\\(page)\"),","        QueryParam(\"limit\", \"\\(limit)\"),","        QueryParam(\"offset\", \"\\((page - 1) * limit)\")","    ]","}","","\/\/ Sorting components factory","func sortingComponents(field: String, order: String = \"asc\") -> [RequestComponent] {","    return [","        QueryParam(\"sort\", field),","        QueryParam(\"order\", order)","    ]","}","","\/\/ Usage","let request = HTTPRequest {","    GET(\"\/api\/users\")","    paginationComponents(page: 2, limit: 50)","    sortingComponents(field: \"name\", order: \"desc\")","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Component-Patterns","type":"heading","text":"Component Patterns"},{"level":3,"anchor":"Builder-Pattern-Components","type":"heading","text":"Builder Pattern Components"},{"inlineContent":[{"text":"Components that configure themselves:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Configurable cache component","struct CacheConfiguration: RequestComponent {","    private var policy: URLRequest.CachePolicy = .useProtocolCachePolicy","    private var maxAge: TimeInterval = 300","    ","    func policy(_ policy: URLRequest.CachePolicy) -> Self {","        var copy = self","        copy.policy = policy","        return copy","    }","    ","    func maxAge(_ seconds: TimeInterval) -> Self {","        var copy = self","        copy.maxAge = seconds","        return copy","    }","    ","    func apply(to request: inout HTTPRequest) throws {","        request.cachePolicy = policy","        request.headers[\"Cache-Control\"] = \"max-age=\\(Int(maxAge))\"","    }","}","","\/\/ Usage","let request = HTTPRequest {","    GET(\"\/api\/data\")","    CacheConfiguration()","        .policy(.reloadIgnoringLocalCacheData)","        .maxAge(600)","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Conditional-Application","level":3,"type":"heading","text":"Conditional Application"},{"inlineContent":[{"type":"text","text":"Apply components based on runtime conditions:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let request = HTTPRequest {","    GET(\"\/api\/data\")","    ","    \/\/ Apply authentication if user is logged in","    if user.isLoggedIn {","        BearerAuth(user.token)","    }","    ","    \/\/ Apply debug headers in development","    if Environment.isDevelopment {","        Header(\"X-Debug\", \"true\")","        Header(\"X-Environment\", \"development\")","    }","    ","    \/\/ Apply premium features for premium users","    if user.isPremium {","        QueryParam(\"include_premium\", \"true\")","    }","}"]},{"anchor":"Component-Error-Handling","level":2,"type":"heading","text":"Component Error Handling"},{"anchor":"Component-Level-Errors","level":3,"type":"heading","text":"Component-Level Errors"},{"inlineContent":[{"type":"text","text":"Handle errors at the component level:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct SafeHeader: RequestComponent {","    let name: String","    let value: String","    ","    func apply(to request: inout HTTPRequest) throws {","        guard !name.isEmpty else {","            throw RequestError.invalidHeader(\"Header name cannot be empty\")","        }","        ","        guard name.allSatisfy({ $0.isASCII && !$0.isWhitespace }) else {","            throw RequestError.invalidHeader(\"Header name contains invalid characters\")","        }","        ","        request.headers[name] = value","    }","}"]},{"anchor":"Component-Validation-Chain","level":3,"type":"heading","text":"Component Validation Chain"},{"inlineContent":[{"type":"text","text":"Validate components before application:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension RequestComponent {","    func validated() -> ValidatedComponent<Self> {","        return ValidatedComponent(self)","    }","}","","struct ValidatedComponent<T: RequestComponent>: RequestComponent {","    let component: T","    ","    init(_ component: T) {","        self.component = component","    }","    ","    func apply(to request: inout HTTPRequest) throws {","        \/\/ Perform pre-validation","        try validateComponent(component, for: request)","        ","        \/\/ Apply the component","        try component.apply(to: &request)","        ","        \/\/ Perform post-validation","        try validateRequest(request)","    }","}"]},{"anchor":"Performance-Considerations","level":2,"type":"heading","text":"Performance Considerations"},{"anchor":"Component-Efficiency","level":3,"type":"heading","text":"Component Efficiency"},{"items":[{"content":[{"inlineContent":[{"text":"Components are applied in order during request building","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Avoid expensive operations in component "},{"type":"codeVoice","code":"apply"},{"type":"text","text":" methods"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cache computed values when possible","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Use lazy evaluation for optional components","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Memory-Management","level":3,"type":"heading","text":"Memory Management"},{"syntax":"swift","type":"codeListing","code":["\/\/ Efficient component design","struct EfficientComponent: RequestComponent {","    \/\/ Use value types when possible","    let value: String","    ","    \/\/ Avoid retaining unnecessary references","    func apply(to request: inout HTTPRequest) throws {","        \/\/ Direct manipulation is more efficient than creating new objects","        request.headers[\"X-Value\"] = value","    }","}"]}]}],"references":{"doc://com.brunogama.networking/documentation/Networking/HTTPMethods":{"url":"\/documentation\/networking\/httpmethods","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/HTTPMethods","title":"HTTP Methods","abstract":[{"type":"text","text":"Comprehensive HTTP method support with type-safe method definitions and custom method capabilities."}],"type":"topic","role":"article","kind":"article"},"doc://com.brunogama.networking/documentation/Networking/ConditionalRequests":{"title":"Conditional Requests","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/ConditionalRequests","kind":"article","abstract":[{"type":"text","text":"Build dynamic HTTP requests that adapt to runtime conditions using conditional components and control flow."}],"type":"topic","role":"article","url":"\/documentation\/networking\/conditionalrequests"},"doc://com.brunogama.networking/documentation/Networking":{"title":"Networking","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking","kind":"article","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/networking"},"doc://com.brunogama.networking/documentation/Networking/RequestBuilding":{"type":"topic","url":"\/documentation\/networking\/requestbuilding","abstract":[{"type":"text","text":"Build HTTP requests declaratively using the RequestBuilder DSL and component system."}],"kind":"article","role":"article","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestBuilding","title":"Request Building"}}}