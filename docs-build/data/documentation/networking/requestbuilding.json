{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestBuilding"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Networking framework provides a powerful, declarative way to build HTTP requests using result builders. This approach makes request construction readable, type-safe, and composable while supporting complex request patterns."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The request building system consists of:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"RequestBuilder"}],"type":"strong"},{"text":": A result builder for declarative request construction","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"RequestComponent","type":"text"}],"type":"strong"},{"text":": Protocol for request building components","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Predefined Components"}],"type":"strong"},{"text":": Common components for HTTP methods, headers, body content, and more","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Conditional Logic"}],"type":"strong"},{"text":": Support for conditional request building","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Basic Request Building","level":2,"anchor":"Basic-Request-Building"},{"type":"heading","text":"Simple Requests","level":3,"anchor":"Simple-Requests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create requests using the clean DSL syntax:"}]},{"code":["\/\/ GET request","let request = HTTPRequest {","    GET(\"\/api\/users\")","}","","\/\/ POST request with JSON body","let request = HTTPRequest {","    POST(\"\/api\/users\")","    Header(\"Content-Type\", \"application\/json\")","    JSONBody(newUser)","}","","\/\/ PUT request with authentication","let request = HTTPRequest {","    PUT(\"\/api\/users\/123\")","    BearerAuth(token)","    JSONBody(updatedUser)","    Timeout(30.0)","}"],"syntax":"swift","type":"codeListing"},{"text":"Executing Requests","level":3,"anchor":"Executing-Requests","type":"heading"},{"inlineContent":[{"text":"Use requests directly with NetworkClient:","type":"text"}],"type":"paragraph"},{"code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","}","","let response = try await client.execute {","    GET(\"\/users\/123\")","    Header(\"Accept\", \"application\/json\")","}"],"syntax":"swift","type":"codeListing"},{"text":"HTTP Methods","level":2,"anchor":"HTTP-Methods","type":"heading"},{"text":"Standard HTTP Methods","level":3,"anchor":"Standard-HTTP-Methods","type":"heading"},{"inlineContent":[{"type":"text","text":"All standard HTTP methods are supported:"}],"type":"paragraph"},{"code":["\/\/ GET request","let getRequest = HTTPRequest {","    GET(\"\/api\/resource\")","}","","\/\/ POST request  ","let postRequest = HTTPRequest {","    POST(\"\/api\/resource\")","    JSONBody(data)","}","","\/\/ PUT request","let putRequest = HTTPRequest {","    PUT(\"\/api\/resource\/123\")","    JSONBody(updatedData)","}","","\/\/ DELETE request","let deleteRequest = HTTPRequest {","    DELETE(\"\/api\/resource\/123\")","}","","\/\/ PATCH request","let patchRequest = HTTPRequest {","    PATCH(\"\/api\/resource\/123\")","    JSONBody(partialUpdate)","}","","\/\/ HEAD request","let headRequest = HTTPRequest {","    HEAD(\"\/api\/resource\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Custom HTTP Methods","level":3,"anchor":"Custom-HTTP-Methods","type":"heading"},{"inlineContent":[{"type":"text","text":"Support for non-standard HTTP methods:"}],"type":"paragraph"},{"code":["\/\/ Using custom method","let customRequest = HTTPRequest {","    Method(\"CUSTOM\")","    Path(\"\/api\/custom-endpoint\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Request Components","level":2,"anchor":"Request-Components","type":"heading"},{"text":"Headers","level":3,"anchor":"Headers","type":"heading"},{"inlineContent":[{"text":"Add headers to your requests:","type":"text"}],"type":"paragraph"},{"code":["let request = HTTPRequest {","    GET(\"\/api\/data\")","    ","    \/\/ Individual headers","    Header(\"Accept\", \"application\/json\")","    Header(\"X-Client-Version\", \"1.0\")","    ","    \/\/ Content-Type shortcuts","    ContentType(.json)        \/\/ application\/json","    ContentType(.xml)         \/\/ application\/xml","    ContentType(.formURLEncoded) \/\/ application\/x-www-form-urlencoded","    ","    \/\/ Accept shortcuts","    AcceptHeader(.json)       \/\/ Accept: application\/json","    AcceptHeader(.xml)        \/\/ Accept: application\/xml","    ","    \/\/ User-Agent","    UserAgent(\"MyApp\/1.0\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Authentication","level":3,"anchor":"Authentication","type":"heading"},{"inlineContent":[{"text":"Add authentication to individual requests:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Bearer token","let request = HTTPRequest {","    GET(\"\/api\/protected\")","    BearerAuth(\"your-token-here\")","}","","\/\/ Basic authentication","let request = HTTPRequest {","    GET(\"\/api\/protected\")","    RequestBasicAuth(username: \"user\", password: \"pass\")","}","","\/\/ API Key","let request = HTTPRequest {","    GET(\"\/api\/protected\")","    APIKey(\"X-API-Key\", \"your-api-key\")","}","","\/\/ Custom authentication","let request = HTTPRequest {","    GET(\"\/api\/protected\")","    Header(\"Authorization\", \"Custom \\(customToken)\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Query Parameters","level":3,"anchor":"Query-Parameters","type":"heading"},{"inlineContent":[{"type":"text","text":"Add query parameters to requests:"}],"type":"paragraph"},{"code":["let request = HTTPRequest {","    GET(\"\/api\/search\")","    ","    \/\/ Individual parameters","    QueryParam(\"q\", \"swift networking\")","    QueryParam(\"limit\", \"10\")","    QueryParam(\"offset\", \"0\")","    ","    \/\/ Multiple parameters at once","    QueryParams([","        \"sort\": \"name\",","        \"order\": \"asc\",","        \"filter\": \"active\"","    ])","}"],"syntax":"swift","type":"codeListing"},{"text":"Request Body","level":3,"anchor":"Request-Body","type":"heading"},{"inlineContent":[{"text":"Add different types of request bodies:","type":"text"}],"type":"paragraph"},{"code":["\/\/ JSON body (automatically sets Content-Type)","struct User: Codable {","    let name: String","    let email: String","}","","let request = HTTPRequest {","    POST(\"\/api\/users\")","    JSONBody(User(name: \"John\", email: \"john@example.com\"))","}","","\/\/ Raw Data body","let request = HTTPRequest {","    POST(\"\/api\/data\")","    DataBody(myData)","    ContentType(.octetStream)","}","","\/\/ Form body (automatically sets Content-Type)","let request = HTTPRequest {","    POST(\"\/api\/form\")","    FormBody([","        \"name\": \"John Doe\",","        \"email\": \"john@example.com\",","        \"subscribe\": \"true\"","    ])","}","","\/\/ String body","let request = HTTPRequest {","    POST(\"\/api\/text\")","    StringBody(\"Plain text content\")","    ContentType(.plainText)","}"],"syntax":"swift","type":"codeListing"},{"text":"Request Configuration","level":3,"anchor":"Request-Configuration","type":"heading"},{"inlineContent":[{"text":"Configure request-specific settings:","type":"text"}],"type":"paragraph"},{"code":["let request = HTTPRequest {","    GET(\"\/api\/slow-endpoint\")","    ","    \/\/ Custom timeout for this request","    RequestTimeout(60.0)","    ","    \/\/ Override base URL for this request  ","    RequestBaseURL(\"https:\/\/different-api.example.com\")","    ","    \/\/ Cache control","    CachePolicy(.reloadIgnoringLocalCacheData)","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Conditional-Request-Building","type":"heading","text":"Conditional Request Building"},{"level":3,"anchor":"Conditional-Components","type":"heading","text":"Conditional Components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build requests dynamically based on runtime conditions:"}]},{"type":"codeListing","code":["let includeAuth = user.isLoggedIn","let includeDetails = user.isPremium","","let request = HTTPRequest {","    GET(\"\/api\/profile\")","    ","    \/\/ Conditional authentication","    if(includeAuth) {","        BearerAuth(user.token)","    }","    ","    \/\/ Conditional query parameters","    if(includeDetails) {","        QueryParam(\"include\", \"premium-details\")","    }","}"],"syntax":"swift"},{"level":3,"anchor":"Conditional-Helper","type":"heading","text":"Conditional Helper"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the conditional helper for cleaner code:"}]},{"type":"codeListing","code":["let request = HTTPRequest {","    GET(\"\/api\/data\")","    ","    ConditionalComponent(user.isLoggedIn) {","        BearerAuth(user.token)","        Header(\"X-User-ID\", user.id)","    }","    ","    ConditionalComponent(!searchTerm.isEmpty) {","        QueryParam(\"search\", searchTerm)","    }","}"],"syntax":"swift"},{"level":2,"anchor":"Advanced-Patterns","type":"heading","text":"Advanced Patterns"},{"level":3,"anchor":"Request-Composition","type":"heading","text":"Request Composition"},{"type":"paragraph","inlineContent":[{"text":"Build reusable request components:","type":"text"}]},{"type":"codeListing","code":["\/\/ Common authentication component","@RequestBuilder","func commonAuth(for user: User) -> [RequestComponent] {","    if user.isLoggedIn {","        BearerAuth(user.token)","        Header(\"X-User-ID\", user.id)","    }","}","","\/\/ Common headers component","@RequestBuilder  ","func commonHeaders() -> [RequestComponent] {","    Header(\"Accept\", \"application\/json\")","    Header(\"X-Client-Version\", \"1.0\")","    UserAgent(\"MyApp\/1.0\")","}","","\/\/ Use in requests","let request = HTTPRequest {","    GET(\"\/api\/profile\")","    commonAuth(for: currentUser)","    commonHeaders()","}"],"syntax":"swift"},{"level":3,"anchor":"Request-Templates","type":"heading","text":"Request Templates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create request templates for common patterns:"}]},{"type":"codeListing","code":["\/\/ API request template","func apiRequest<T: Codable>(","    method: HTTPMethod,","    path: String,","    body: T? = nil,","    authenticated: Bool = true",") -> HTTPRequest {","    HTTPRequest {","        Method(method.rawValue)","        Path(path)","        ","        commonHeaders()","        ","        if authenticated {","            commonAuth(for: currentUser)","        }","        ","        if let body = body {","            JSONBody(body)","        }","    }","}","","\/\/ Use template","let request = apiRequest(","    method: .post,","    path: \"\/api\/users\",","    body: newUser,","    authenticated: true",")"],"syntax":"swift"},{"level":3,"anchor":"Request-Validation","type":"heading","text":"Request Validation"},{"type":"paragraph","inlineContent":[{"text":"Add validation to request components:","type":"text"}]},{"type":"codeListing","code":["struct ValidatedPath: RequestComponent {","    let path: String","    ","    init(_ path: String) throws {","        guard path.starts(with: \"\/\") else {","            throw RequestError.invalidPath(\"Path must start with \/\")","        }","        guard !path.contains(\"..\") else {","            throw RequestError.invalidPath(\"Path cannot contain ..\")","        }","        self.path = path","    }","    ","    func apply(to request: inout HTTPRequest) throws {","        \/\/ Apply validated path","    }","}","","\/\/ Use validated component","let request = HTTPRequest {","    GET(try ValidatedPath(\"\/api\/safe-path\"))","}"],"syntax":"swift"},{"level":2,"anchor":"Component-Reference","type":"heading","text":"Component Reference"},{"level":3,"anchor":"HTTP-Method-Components","type":"heading","text":"HTTP Method Components"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Component","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Example","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"GET(path)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"HTTP GET request","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"GET(\"\/users\")","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"POST(path)"}]}],[{"type":"paragraph","inlineContent":[{"text":"HTTP POST request","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"POST(\"\/users\")","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"PUT(path)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"HTTP PUT request","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"PUT(\"\/users\/123\")","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DELETE(path)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"HTTP DELETE request"}]}],[{"type":"paragraph","inlineContent":[{"code":"DELETE(\"\/users\/123\")","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PATCH(path)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"HTTP PATCH request"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PATCH(\"\/users\/123\")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"HEAD(path)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"HTTP HEAD request"}]}],[{"type":"paragraph","