{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/MiddlewareOverview"},"hierarchy":{"paths":[["doc:\/\/com.brunogama.networking\/documentation\/Networking"]]},"abstract":[{"type":"text","text":"Extensible request and response processing pipeline for cross-cutting concerns like authentication, caching, retry logic, and observability."}],"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The middleware system in the Networking framework provides a powerful way to process HTTP requests and responses through a composable pipeline. Middleware components can be chained together to handle cross-cutting concerns without cluttering your main request logic."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Key middleware capabilities:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Request Processing","type":"text"}]},{"text":": Transform requests before execution","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Response Processing","type":"text"}],"type":"strong"},{"text":": Process responses after execution","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Error Handling"}]},{"text":": Handle and transform errors","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Composable Pipeline","type":"text"}]},{"type":"text","text":": Chain multiple middleware together"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Built-in Middleware","type":"text"}],"type":"strong"},{"text":": Common functionality ready to use","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Custom Middleware"}],"type":"strong"},{"type":"text","text":": Create specialized middleware for your needs"}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Middleware Architecture","anchor":"Middleware-Architecture"},{"level":3,"type":"heading","text":"Processing Pipeline","anchor":"Processing-Pipeline"},{"inlineContent":[{"type":"text","text":"Middleware processes requests and responses in a predictable pipeline:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Request → Middleware Chain → Network → Middleware Chain → Response","    ↓                                          ↓","Error Middleware ← ← ← ← ← ← ← ← ← ← ← ← ← ← Error"]},{"anchor":"Middleware-Types","type":"heading","text":"Middleware Types","level":3},{"type":"paragraph","inlineContent":[{"text":"The framework supports different types of middleware:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Process requests before network execution","public protocol HTTPRequestMiddleware: Sendable {","    func modifyRequest(_ request: HTTPRequest) async throws -> HTTPRequest","}","","\/\/\/ Process responses after network execution","public protocol HTTPResponseMiddleware: Sendable {","    func processResponse(_ response: HTTPResponse) async throws -> HTTPResponse","}","","\/\/\/ Handle errors that occur during request execution","public protocol HTTPErrorMiddleware: Sendable {","    func handleError(_ error: HTTPError) async throws -> HTTPError","}"]},{"text":"Built-in Middleware","level":2,"anchor":"Built-in-Middleware","type":"heading"},{"text":"Authentication Middleware","level":3,"anchor":"Authentication-Middleware","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Automatically handle authentication for all requests:"}]},{"type":"codeListing","syntax":"swift","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    \/\/ Bearer token authentication","    BearerTokenMiddleware(token: \"your-token\")","    ","    \/\/ Basic authentication","    BasicAuthMiddleware(username: \"user\", password: \"pass\")","    ","    \/\/ API key authentication","    APIKeyMiddleware(header: \"X-API-Key\", key: \"your-api-key\")","}"]},{"anchor":"Retry-Middleware","text":"Retry Middleware","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Automatically retry failed requests with configurable strategies:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    EnableRetry {","        MaxAttempts(3)","        BackoffStrategy(.exponential(multiplier: 2.0))","        RetryCondition(.networkErrors)","        RetryCondition(.serverErrors)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Retry Strategies:","type":"text"}]}]},{"code":["\/\/ Exponential backoff: 1s, 2s, 4s, 8s...","BackoffStrategy(.exponential(multiplier: 2.0))","","\/\/ Linear backoff: 1s, 2s, 3s, 4s...","BackoffStrategy(.linear(increment: 1.0))","","\/\/ Fixed delay: 5s, 5s, 5s, 5s...","BackoffStrategy(.fixed(delay: 5.0))","","\/\/ Custom backoff","BackoffStrategy(.custom { attempt in","    Double(attempt * attempt) \/\/ Quadratic backoff","})"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Caching-Middleware","level":3,"text":"Caching Middleware"},{"type":"paragraph","inlineContent":[{"text":"Cache responses to reduce network traffic and improve performance:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    EnableCaching {","        \/\/ Cache policy","        Policy(.standard)","        Policy(.aggressive)","        Policy(.networkFirst)","        ","        \/\/ Storage options","        Storage(.memory(maxSize: .megabytes(50)))","        Storage(.disk(maxSize: .megabytes(500)))","        Storage(.hybrid(memorySize: .megabytes(50), diskSize: .megabytes(500)))","        ","        \/\/ Cache duration","        Duration(.minutes(15))","        Duration(.hours(2))","        Duration(.custom(300))","    }","}"]},{"anchor":"Logging-Middleware","text":"Logging Middleware","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Log requests and responses for debugging and monitoring:","type":"text"}]},{"code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    EnableLogging {","        \/\/ Log level","        Level(.debug)    \/\/ Log everything","        Level(.info)     \/\/ Log basic request\/response info","        Level(.error)    \/\/ Log only errors","        ","        \/\/ Log components","        LogRequests(true)","        LogResponses(true)","        LogHeaders(true)","        LogBodies(false) \/\/ Be careful with sensitive data","        ","        \/\/ Custom logger","        Logger(OSLog.default)","        Logger(CustomLogger())","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Observability Middleware","anchor":"Observability-Middleware","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Collect metrics and traces for monitoring:"}],"type":"paragraph"},{"syntax":"swift","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    EnableObservability {","        \/\/ Metrics collection","        CollectMetrics(true)","        ","        \/\/ Request timing","        TrackTiming(true)","        ","        \/\/ Custom metrics handler","        MetricsHandler(CustomMetricsCollector())","        ","        \/\/ Distributed tracing","        EnableTracing(true)","        TraceHeaders([\"X-Trace-ID\", \"X-Span-ID\"])","    }","}"],"type":"codeListing"},{"level":2,"type":"heading","text":"Creating Custom Middleware","anchor":"Creating-Custom-Middleware"},{"level":3,"type":"heading","text":"Request Middleware","anchor":"Request-Middleware"},{"inlineContent":[{"type":"text","text":"Transform requests before they’re sent:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Add API version header to all requests","struct APIVersionMiddleware: HTTPRequestMiddleware {","    let version: String","    ","    func modifyRequest(_ request: HTTPRequest) async throws -> HTTPRequest {","        var modifiedRequest = request","        modifiedRequest.headers[\"X-API-Version\"] = version","        return modifiedRequest","    }","}","","\/\/ Rate limiting middleware","struct RateLimitMiddleware: HTTPRequestMiddleware {","    private let rateLimiter: RateLimiter","    ","    init(requestsPerSecond: Int) {","        self.rateLimiter = RateLimiter(rate: requestsPerSecond)","    }","    ","    func modifyRequest(_ request: HTTPRequest) async throws -> HTTPRequest {","        try await rateLimiter.waitForPermission()","        return request","    }","}","","\/\/ Usage","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    Middleware(APIVersionMiddleware(version: \"v2\"))","    Middleware(RateLimitMiddleware(requestsPerSecond: 10))","}"],"type":"codeListing"},{"anchor":"Response-Middleware","type":"heading","text":"Response Middleware","level":3},{"type":"paragraph","inlineContent":[{"text":"Process responses after they’re received:","type":"text"}]},{"code":["\/\/ Extract and store response timing","struct TimingMiddleware: HTTPResponseMiddleware {","    func processResponse(_ response: HTTPResponse) async throws -> HTTPResponse {","        if let serverTime = response.headers[\"X-Response-Time\"],","           let serverTimeMs = Double(serverTime) {","            print(\"Server processing time: \\(serverTimeMs)ms\")","            ","            \/\/ Store timing data","            await MetricsStore.shared.recordResponseTime(serverTimeMs)","        }","        ","        return response","    }","}","","\/\/ Transform response headers","struct HeaderTransformMiddleware: HTTPResponseMiddleware {","    func processResponse(_ response: HTTPResponse) async throws -> HTTPResponse {","        var modifiedResponse = response","        ","        \/\/ Normalize header names","        let normalizedHeaders = response.headers.reduce(into: [String: String]()) { result, pair in","            result[pair.key.lowercased()] = pair.value","        }","        ","        modifiedResponse.headers = normalizedHeaders","        return modifiedResponse","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Error Middleware","anchor":"Error-Middleware","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle and transform errors:"}]},{"code":["\/\/ Automatic token refresh on 401 errors","struct TokenRefreshMiddleware: HTTPErrorMiddleware {","    private let authService: AuthService","    ","    init(authService: AuthService) {","        self.authService = authService","    }","    ","    func handleError(_ error: HTTPError) async throws -> HTTPError {","        \/\/ Check if this is an authentication error","        guard case .http(let status) = error.category,","              status.code == 401 else {","            return error \/\/ Not an auth error, pass through","        }","        ","        do {","            \/\/ Attempt token refresh","            let newToken = try await authService.refreshToken()","            ","            \/\/ Update the original request with new token","            if var request = error.request {","                request.headers[\"Authorization\"] = \"Bearer \\(newToken)\"","                ","                \/\/ Create a new error that suggests retry with updated request","                return HTTPError(","                    category: .retryableWithUpdatedRequest(request),","                    userFriendlyDescription: \"Authentication refreshed, retrying...\",","                    request: request,","                    response: error.response","                )","            }","        } catch {","            \/\/ Token refresh failed, convert to authentication required error","            return HTTPError(","                category: .authenticationRequired,","                userFriendlyDescription: \"Please log in again\",","                request: error.request,","                response: error.response","            )","        }","        ","        return error","    }","}","","\/\/ Circuit breaker error middleware","struct CircuitBreakerMiddleware: HTTPErrorMiddleware {","    private let circuitBreaker: CircuitBreaker","    ","    init(failureThreshold: Int = 5, recoveryTime: TimeInterval = 30) {","        self.circuitBreaker = CircuitBreaker(","            failureThreshold: failureThreshold,","            recoveryTime: recoveryTime","        )","    }","    ","    func handleError(_ error: HTTPError) async throws -> HTTPError {","        \/\/ Record the failure","        await circuitBreaker.recordFailure()","        ","        \/\/ Check if circuit should be opened","        if await circuitBreaker.shouldReject() {","            return HTTPError(","                category: .circuitBreakerOpen,","                userFriendlyDescription: \"Service temporarily unavailable\",","                request: error.request,","                response: error.response","            )","        }","        ","        return error","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Middleware Composition","anchor":"Middleware-Composition","level":2},{"type":"heading","text":"Middleware Ordering","anchor":"Middleware-Ordering","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Middleware execution order matters. Request middleware executes in the order they’re added, response middleware executes in reverse order:"}]},{"type":"codeListing","syntax":"swift","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    \/\/ Request middleware (executes in this order)","    Middleware(AuthenticationMiddleware())   \/\/ 1st","    Middleware(RateLimitMiddleware())        \/\/ 2nd  ","    Middleware(LoggingMiddleware())          \/\/ 3rd","    ","    \/\/ Response middleware (executes in reverse order)","    \/\/ LoggingMiddleware processes response first","    \/\/ RateLimitMiddleware processes response second","    \/\/ AuthenticationMiddleware processes response last","}"]},{"anchor":"Conditional-Middleware","type":"heading","level":3,"text":"Conditional Middleware"},{"type":"paragraph","inlineContent":[{"text":"Apply middleware based on conditions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ConditionalMiddleware<T: HTTPRequestMiddleware>: HTTPRequestMiddleware {","    let middleware: T","    let condition: () -> Bool","    ","    func modifyRequest(_ request: HTTPRequest) async throws -> HTTPRequest {","        if condition() {","            return try await middleware.modifyRequest(request)","        }","        return request","    }","}","","\/\/ Usage","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    \/\/ Only apply debug middleware in debug builds","    Middleware(ConditionalMiddleware(","        middleware: DebugHeadersMiddleware(),","        condition: { ","            #if DEBUG","            return true","            #else","            return false","            #endif","        }","    ))","}"]},{"level":3,"type":"heading","anchor":"Middleware-Groups","text":"Middleware Groups"},{"inlineContent":[{"text":"Create reusable middleware combinations:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Production middleware stack","@MiddlewareBuilder","func productionMiddleware(apiKey: String) -> [Middleware] {","    APIKeyMiddleware(key: apiKey)","    ","    EnableRetry {","        MaxAttempts(3)","        BackoffStrategy(.exponential(multiplier: 2.0))","    }","    ","    EnableCaching {","        Policy(.standard)","        Duration(.minutes(15))","    }","    ","    EnableObservability {","        CollectMetrics(true)","        TrackTiming(true)","    }","}","","\/\/ Development middleware stack","@MiddlewareBuilder  ","func developmentMiddleware(apiKey: String) -> [Middleware] {","    APIKeyMiddleware(key: apiKey)","    ","    EnableLogging {","        Level(.debug)","        LogRequests(true)","        LogResponses(true)","        LogHeaders(true)","    }","    ","    EnableRetry {","        MaxAttempts(1) \/\/ Less aggressive retry in development","    }","}","","\/\/ Usage","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    #if DEBUG","    developmentMiddleware(apiKey: \"dev-key\")","    #else","    productionMiddleware(apiKey: \"prod-key\")","    #endif","}"]},{"type":"heading","text":"Advanced Middleware Patterns","anchor":"Advanced-Middleware-Patterns","level":2},{"type":"heading","text":"Stateful Middleware","anchor":"Stateful-Middleware","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Middleware that maintains state between requests:"}]},{"syntax":"swift","type":"codeListing","code":["actor RequestCounterMiddleware: HTTPRequestMiddleware {","    private var requestCount = 0","    ","    func modifyRequest(_ request: HTTPRequest) async throws -> HTTPRequest {","        requestCount += 1","        ","        var modifiedRequest = request","        modifiedRequest.headers[\"X-Request-Count\"] = \"\\(requestCount)\"","        return modifiedRequest","    }","    ","    func getRequestCount() async -> Int {","        return requestCount","    }","}"]},{"text":"Middleware with Dependencies","anchor":"Middleware-with-Dependencies","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Middleware that depends on external services:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["class MetricsMiddleware: HTTPResponseMiddleware {","    private let metricsService: MetricsService","    private let configuration: MetricsConfiguration","    ","    init(metricsService: MetricsService, configuration: MetricsConfiguration) {","        self.metricsService = metricsService","        self.configuration = configuration","    }","    ","    func processResponse(_ response: HTTPResponse) async throws -> HTTPResponse {","        \/\/ Collect metrics based on configuration","        if configuration.trackResponseTimes {","            await metricsService.recordResponseTime(response.requestDuration)","        }","        ","        if configuration.trackStatusCodes {","            await metricsService.recordStatusCode(response.status.code)","        }","        ","        if configuration.trackErrorRates && !response.status.isSuccess {","            await metricsService.recordError(response.status.code)","        }","        ","        return response","    }","}"]},{"text":"Middleware Factories","anchor":"Middleware-Factories","type":"heading","level":3},{"inlineContent":[{"text":"Create middleware based on configuration:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["enum MiddlewareFactory {","    static func createAuthenticationMiddleware(","        for environment: Environment,","        with credentials: Credentials","    ) -> HTTPRequestMiddleware {","        switch environment {","        case .development:","            return MockAuthMiddleware(mockToken: \"dev-token\")","        case .staging:","            return BasicAuthMiddleware(","                username: credentials.username,","                password: credentials.password","            )","        case .production:","            return BearerTokenMiddleware(token: credentials.accessToken)","        }","    }","    ","    static func createRetryMiddleware(","        for environment: Environment","    ) -> RetryMiddleware {","        switch environment {","        case .development:","            return RetryMiddleware(maxAttempts: 1) \/\/ No retry in dev","        case .staging:","            return RetryMiddleware(","                maxAttempts: 2,","                backoffStrategy: .linear(increment: 1.0)","            )","        case .production:","            return RetryMiddleware(","                maxAttempts: 3,","                backoffStrategy: .exponential(multiplier: 2.0)","            )","        }","    }","}"]},{"anchor":"Middleware-Testing","type":"heading","level":2,"text":"Middleware Testing"},{"text":"Testing Individual Middleware","level":3,"anchor":"Testing-Individual-Middleware","type":"heading"},{"type":"codeListing","code":["@Test func testAPIVersionMiddleware() async throws {","    let middleware = APIVersionMiddleware(version: \"v2\")","    let originalRequest = HTTPRequest(method: .get, url: URL(string: \"https:\/\/api.example.com\/data\")!)","    ","    let modifiedRequest = try await middleware.modifyRequest(originalRequest)","    ","    #expect(modifiedRequest.headers[\"X-API-Version\"] == \"v2\")","}","","@Test func testTimingMiddleware() async throws {","    let middleware = TimingMiddleware()","    let response = HTTPResponse(","        request: HTTPRequest(method: .get, url: URL(string: \"https:\/\/api.example.com\")!),","        status: .ok,","        headers: [\"X-Response-Time\": \"150\"],","        body: nil,","        url: nil","    )","    ","    let processedResponse = try await middleware.processResponse(response)","    ","    \/\/ Verify timing was recorded","    let recordedTime = await MetricsStore.shared.getLastRecordedTime()","    #expect(recordedTime == 150.0)","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"Integration Testing","anchor":"Integration-Testing"},{"inlineContent":[{"text":"Test middleware in combination:","type":"text"}],"type":"paragraph"},{"code":["@Test func testMiddlewareIntegration() async throws {","    let client = NetworkClient {","        BaseURL(\"https:\/\/httpbin.org\")","        Middleware(APIVersionMiddleware(version: \"v1\"))","        Middleware(AuthHeaderMiddleware(token: \"test-token\"))","    }","    ","    let response = try await client.execute {","        GET(\"\/headers\")","    }","    ","    \/\/ Verify both middleware effects are present","    let responseData = try response.decode([String: Any].self)","    let headers = responseData[\"headers\"] as? [String: String]","    ","    #expect(headers?[\"X-Api-Version\"] == \"v1\")","    #expect(headers?[\"Authorization\"] == \"Bearer test-token\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Best Practices","anchor":"Best-Practices","level":2},{"text":"Middleware Design Guidelines","anchor":"Middleware-Design-Guidelines","type":"heading","level":3},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Single Responsibility:"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Each middleware should handle one specific concern","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Avoid combining unrelated functionality in one middleware","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keep middleware focused and testable","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Performance Considerations:","type":"text"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Minimize processing in middleware hot paths","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Use async operations efficiently"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Cache expensive computations when possible","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Avoid blocking operations in middleware"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Error Handling:","type":"text"}]}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Middleware should handle their own errors gracefully","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Propagate errors that can’t be handled","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide meaningful error messages and recovery suggestions"}]}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"State Management:"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Prefer stateless middleware when possible","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Use actors for thread-safe stateful middleware"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Consider the lifecycle of stateful middleware","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Middleware-Organization","text":"Middleware Organization","level":3,"type":"heading"},{"syntax":"swift","code":["\/\/ Group related middleware in extensions","extension NetworkClientBuilder {","    func withStandardMiddleware(apiKey: String) -> Self {","        self","            .middleware(APIKeyMiddleware(key: apiKey))","            .middleware(RetryMiddleware(maxAttempts: 3))","            .middleware(CachingMiddleware(duration: .minutes(15)))","    }","    ","    func withObservability() -> Self {","        self","            .middleware(LoggingMiddleware(level: .info))","            .middleware(MetricsMiddleware())","            .middleware(TracingMiddleware())","    }","}"],"type":"codeListing"}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Middleware Overview"},"references":{"doc://com.brunogama.networking/documentation/Networking":{"title":"Networking","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking","kind":"article","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/networking"}}}