{"identifier":{"url":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/HTTPPrimitives","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"The Networking framework provides a set of core types that represent HTTP concepts in a Swift-native way. These primitives form the foundation for all networking operations and are designed to be type-safe, performant, and easy to work with.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Core Types","anchor":"Core-Types"},{"level":3,"type":"heading","text":"HTTPRequest","anchor":"HTTPRequest"},{"type":"paragraph","inlineContent":[{"code":"HTTPRequest","type":"codeVoice"},{"type":"text","text":" represents an HTTP request with all its components:"}]},{"type":"codeListing","code":["\/\/\/ A complete HTTP request representation","public struct HTTPRequest: Sendable, Equatable, Hashable {","    \/\/\/ Unique identifier for the request","    public let id: UUID","    ","    \/\/\/ HTTP method (GET, POST, etc.)","    public let method: HTTPMethod","    ","    \/\/\/ Target URL","    public let url: URL","    ","    \/\/\/ Request headers","    public let headers: [String: String]","    ","    \/\/\/ Request body data","    public let body: Data?","    ","    \/\/\/ Request timeout interval","    public let timeout: TimeInterval","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Creating HTTPRequest instances:","type":"text"}],"type":"strong"}]},{"type":"codeListing","code":["\/\/ Simple GET request","let request = HTTPRequest(","    method: .get,","    url: URL(string: \"https:\/\/api.example.com\/users\")!",")","","\/\/ POST request with body and headers","let request = HTTPRequest(","    method: .post,","    url: URL(string: \"https:\/\/api.example.com\/users\")!,","    headers: [\"Content-Type\": \"application\/json\"],","    body: jsonData,","    timeout: 30.0",")","","\/\/ Using the request builder DSL","let request = HTTPRequest {","    POST(\"\/api\/users\")","    Header(\"Content-Type\", \"application\/json\") ","    JSONBody(user)","    Timeout(30.0)","}"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"HTTPResponse","text":"HTTPResponse"},{"type":"paragraph","inlineContent":[{"code":"HTTPResponse","type":"codeVoice"},{"type":"text","text":" represents an HTTP response with all received data:"}]},{"type":"codeListing","code":["\/\/\/ A complete HTTP response representation","public struct HTTPResponse: Sendable, Equatable {","    \/\/\/ The original request that generated this response","    public let request: HTTPRequest","    ","    \/\/\/ HTTP status code and reason phrase","    public let status: HTTPStatus","    ","    \/\/\/ Response headers","    public let headers: [String: String]","    ","    \/\/\/ Response body data","    public let body: Data?","    ","    \/\/\/ Final URL after redirects","    public let url: URL?","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Working with HTTPResponse:"}]}]},{"type":"codeListing","code":["let response = try await client.execute(request)","","\/\/ Check status","if response.status.isSuccess {","    print(\"Request succeeded: \\(response.status)\")","}","","\/\/ Access headers","let contentType = response.headers[\"Content-Type\"]","let contentLength = response.headers[\"Content-Length\"]","","\/\/ Decode JSON response","struct User: Codable {","    let id: Int","    let name: String","}","","let user: User = try response.decode(User.self)"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"HTTPMethod","text":"HTTPMethod"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"HTTPMethod"},{"type":"text","text":" represents HTTP request methods in a type-safe way:"}]},{"type":"codeListing","code":["\/\/\/ HTTP request methods","public struct HTTPMethod: Sendable, Equatable, Hashable, CustomStringConvertible {","    public let rawValue: String","    ","    \/\/ Standard HTTP methods","    public static let get = HTTPMethod(\"GET\")","    public static let post = HTTPMethod(\"POST\")","    public static let put = HTTPMethod(\"PUT\")","    public static let delete = HTTPMethod(\"DELETE\")","    public static let patch = HTTPMethod(\"PATCH\")","    public static let head = HTTPMethod(\"HEAD\")","    public static let options = HTTPMethod(\"OPTIONS\")","    public static let trace = HTTPMethod(\"TRACE\")","    public static let connect = HTTPMethod(\"CONNECT\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Using HTTPMethod:","type":"text"}],"type":"strong"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Using predefined methods","let request = HTTPRequest(method: .post, url: url)","","\/\/ Custom methods","let customMethod = HTTPMethod(\"PATCH\")","let request = HTTPRequest(method: customMethod, url: url)","","\/\/ Method properties","print(HTTPMethod.get.rawValue) \/\/ \"GET\"","print(HTTPMethod.post.description) \/\/ \"POST\""]},{"level":3,"type":"heading","text":"HTTPStatus","anchor":"HTTPStatus"},{"type":"paragraph","inlineContent":[{"code":"HTTPStatus","type":"codeVoice"},{"text":" provides structured access to HTTP status codes:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ HTTP status code with associated reason phrase and category information","public struct HTTPStatus: Sendable, Equatable, Hashable, CustomStringConvertible {","    \/\/\/ The numeric status code","    public let code: Int","    ","    \/\/\/ The reason phrase (e.g., \"OK\", \"Not Found\")","    public let reasonPhrase: String","    ","    \/\/\/ Whether this is a successful status (2xx)","    public var isSuccess: Bool { code >= 200 && code < 300 }","    ","    \/\/\/ Whether this is a client error (4xx)","    public var isClientError: Bool { code >= 400 && code < 500 }","    ","    \/\/\/ Whether this is a server error (5xx)","    public var isServerError: Bool { code >= 500 && code < 600 }","    ","    \/\/\/ Whether this is a redirection (3xx)","    public var isRedirection: Bool { code >= 300 && code < 400 }","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Common status codes:","type":"text"}],"type":"strong"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Success codes","HTTPStatus.ok                    \/\/ 200 OK","HTTPStatus.created               \/\/ 201 Created","HTTPStatus.accepted              \/\/ 202 Accepted","HTTPStatus.noContent             \/\/ 204 No Content","","\/\/ Client error codes","HTTPStatus.badRequest            \/\/ 400 Bad Request","HTTPStatus.unauthorized          \/\/ 401 Unauthorized","HTTPStatus.forbidden             \/\/ 403 Forbidden","HTTPStatus.notFound              \/\/ 404 Not Found","HTTPStatus.methodNotAllowed      \/\/ 405 Method Not Allowed","HTTPStatus.requestTimeout        \/\/ 408 Request Timeout","HTTPStatus.conflict              \/\/ 409 Conflict","HTTPStatus.unprocessableEntity   \/\/ 422 Unprocessable Entity","HTTPStatus.tooManyRequests       \/\/ 429 Too Many Requests","","\/\/ Server error codes","HTTPStatus.internalServerError   \/\/ 500 Internal Server Error","HTTPStatus.badGateway           \/\/ 502 Bad Gateway","HTTPStatus.serviceUnavailable   \/\/ 503 Service Unavailable","HTTPStatus.gatewayTimeout       \/\/ 504 Gateway Timeout"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Working with HTTPStatus:"}],"type":"strong"}]},{"type":"codeListing","syntax":"swift","code":["let response = try await client.execute(request)","","switch response.status.code {","case 200:","    print(\"Success!\")","case 401:","    print(\"Authentication required\")","case 404:","    print(\"Resource not found\")","case 500..<600:","    print(\"Server error: \\(response.status.reasonPhrase)\")","default:","    print(\"Unexpected status: \\(response.status)\")","}","","\/\/ Using convenience properties","if response.status.isSuccess {","    \/\/ Handle success","} else if response.status.isClientError {","    \/\/ Handle client-side issues","} else if response.status.isServerError {","    \/\/ Handle server-side issues","}"]},{"level":3,"type":"heading","text":"HTTPError","anchor":"HTTPError"},{"type":"paragraph","inlineContent":[{"code":"HTTPError","type":"codeVoice"},{"type":"text","text":" provides comprehensive error information with recovery suggestions:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Comprehensive HTTP error with categorization and recovery information","public struct HTTPError: Error, Sendable, LocalizedError, CustomStringConvertible {","    \/\/\/ Error category (network, HTTP, encoding, etc.)","    public let category: Category","    ","    \/\/\/ Error severity level","    public var severity: ErrorSeverity { category.severity }","    ","    \/\/\/ Whether this error is recoverable","    public var recoveryCategory: RecoveryCategory { category.recoveryCategory }","    ","    \/\/\/ User-friendly error description","    public var userFriendlyDescription: String","    ","    \/\/\/ Actionable recovery suggestions","    public var recoverySuggestions: [String]","    ","    \/\/\/ The request that caused this error","    public let request: HTTPRequest?","    ","    \/\/\/ The response that contained the error (if available)","    public let response: HTTPResponse?","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Error categories:"}],"type":"strong"}]},{"type":"codeListing","syntax":"swift","code":["public enum Category: Sendable, Equatable {","    case network(NetworkError)    \/\/ Connection issues, DNS failures","    case http(HTTPStatus)         \/\/ HTTP status errors (4xx, 5xx)","    case encoding(String)         \/\/ Request encoding failures","    case decoding(String)         \/\/ Response decoding failures","    case timeout                  \/\/ Request timeout","    case invalidURL(String)       \/\/ Malformed URLs","    case cancelled                \/\/ Request was cancelled","    case unknown(String)          \/\/ Unexpected errors","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Error handling patterns:"}]}]},{"type":"codeListing","syntax":"swift","code":["do {","    let response = try await client.execute(request)","    \/\/ Handle success","} catch let error as HTTPError {","    \/\/ Log technical details","    logger.error(\"Request failed: \\(error.description)\")","    ","    \/\/ Show user-friendly message","    showAlert(title: \"Error\", message: error.userFriendlyDescription)","    ","    \/\/ Handle specific error types","    switch error.category {","    case .network(.noConnection):","        \/\/ Offline mode or retry later","        enableOfflineMode()","        ","    case .http(let status) where status.code == 401:","        \/\/ Authentication required","        presentLoginScreen()","        ","    case .http(let status) where status.isServerError:","        \/\/ Server issues - suggest retry","        showRetryOption()","        ","    case .timeout:","        \/\/ Timeout - suggest retry or check connection","        suggestRetryOrCheckConnection()","        ","    default:","        \/\/ Generic error handling","        showGenericErrorMessage()","    }","    ","    \/\/ Use recovery suggestions","    if !error.recoverySuggestions.isEmpty {","        showRecoverySuggestions(error.recoverySuggestions)","    }","}"]},{"level":2,"type":"heading","text":"Type Aliases","anchor":"Type-Aliases"},{"level":3,"type":"heading","text":"HTTPResult","anchor":"HTTPResult"},{"type":"paragraph","inlineContent":[{"text":"Convenient Result type for HTTP operations:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Result type for HTTP operations","public typealias HTTPResult = Result<HTTPResponse, HTTPError>"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Usage:","type":"text"}]}]},{"syntax":"swift","type":"codeListing","code":["func performRequest() -> HTTPResult {","    do {","        let response = try await client.execute(request)","        return .success(response)","    } catch let error as HTTPError {","        return .failure(error)","    }","}","","\/\/ Using the result","let result = performRequest()","switch result {","case .success(let response):","    print(\"Success: \\(response.status)\")","case .failure(let error):","    print(\"Error: \\(error.userFriendlyDescription)\")","}"]},{"anchor":"Thread-Safety","type":"heading","text":"Thread Safety","level":2},{"inlineContent":[{"text":"All HTTP primitive types are ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" and designed for safe concurrent access:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Safe to pass between concurrent contexts","Task {","    let request = HTTPRequest(method: .get, url: url)","    let response = try await client.execute(request)","    ","    await processResponse(response)  \/\/ Safe to pass to other contexts","}"]},{"anchor":"Best-Practices","type":"heading","text":"Best Practices","level":2},{"anchor":"Request-Creation","type":"heading","text":"Request Creation","level":3},{"items":[{"content":[{"inlineContent":[{"text":"Use the request builder DSL for complex requests","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Set appropriate timeouts based on operation type","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Include necessary headers for your API","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Validate URLs before creating requests","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"text":"Response Processing","type":"heading","anchor":"Response-Processing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Always check status codes before processing data","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle different content types appropriately"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use structured error handling for different failure scenarios","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider caching successful responses"}]}]}],"type":"unorderedList"},{"text":"Error Handling","anchor":"Error-Handling","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Catch and handle "},{"code":"HTTPError","type":"codeVoice"},{"type":"text","text":" specifically"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use user-friendly error messages for UI","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement appropriate retry logic based on error category"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Log detailed error information for debugging","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.brunogama.networking\/documentation\/Networking"]]},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestBuilding"],"anchor":"Related-Documentation"}],"kind":"article","metadata":{"roleHeading":"Article","title":"HTTP Primitives","role":"article"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Fundamental types that represent HTTP requests, responses, and related concepts.","type":"text"}],"references":{"doc://com.brunogama.networking/documentation/Networking/RequestBuilding":{"type":"topic","url":"\/documentation\/networking\/requestbuilding","abstract":[{"type":"text","text":"Build HTTP requests declaratively using the RequestBuilder DSL and component system."}],"kind":"article","role":"article","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestBuilding","title":"Request Building"},"doc://com.brunogama.networking/documentation/Networking":{"title":"Networking","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking","kind":"article","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/networking"}}}