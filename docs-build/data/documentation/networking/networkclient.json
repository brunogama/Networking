{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/NetworkClient"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkClient"},{"type":"text","text":" is the main entry point for making HTTP requests in the Networking framework. It provides a powerful, flexible foundation for network communication with support for middleware, caching, authentication, retry logic, and more."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The client is designed around two key principles:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Declarative Configuration"}],"type":"strong"},{"type":"text","text":": Use result builders to configure the client in a readable, type-safe way"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Middleware Pipeline"}],"type":"strong"},{"text":": Extend functionality through composable middleware components","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Basic Usage","level":2,"anchor":"Basic-Usage"},{"type":"heading","text":"Simple Client Creation","level":3,"anchor":"Simple-Client-Creation"},{"type":"paragraph","inlineContent":[{"text":"Create a basic client for immediate use:","type":"text"}]},{"type":"codeListing","code":["import Networking","","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    DefaultTimeout(30.0)","}","","let response = try await client.execute {","    GET(\"\/users\")","}"],"syntax":"swift"},{"type":"heading","text":"Advanced Configuration","level":3,"anchor":"Advanced-Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure a client with middleware and advanced features:"}]},{"type":"codeListing","code":["let client = NetworkClient {","    \/\/ Base configuration","    BaseURL(\"https:\/\/api.example.com\")","    DefaultTimeout(30.0)","    DefaultHeader(\"User-Agent\", \"MyApp\/1.0\")","    ","    \/\/ Authentication","    BearerToken(\"your-api-key\")","    ","    \/\/ Middleware","    EnableRetry {","        MaxAttempts(3)","        BackoffStrategy(.exponential(multiplier: 2.0))","    }","    ","    EnableCaching {","        Policy(.standard)","        Storage(.memory(maxSize: .megabytes(50)))","    }","    ","    EnableLogging()","    ","    \/\/ Security","    EnableSecurity {","        CertificatePinning(sha256Hashes: [\"abc123...\"])","        MinTLSVersion(.v1_2)","    }","}"],"syntax":"swift"},{"type":"heading","text":"Architecture","level":2,"anchor":"Architecture"},{"type":"heading","text":"HTTPClient Protocol","level":3,"anchor":"HTTPClient-Protocol"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkClient"},{"text":" conforms to the ","type":"text"},{"type":"codeVoice","code":"HTTPClient"},{"text":" protocol:","type":"text"}]},{"type":"codeListing","code":["\/\/\/ Protocol for executing HTTP requests","public protocol HTTPClient: Sendable {","    \/\/\/ Execute an HTTP request asynchronously","    \/\/\/ - Parameter request: The request to execute","    \/\/\/ - Returns: The HTTP response","    \/\/\/ - Throws: HTTPError on failure","    func execute(_ request: HTTPRequest) async throws -> HTTPResponse","}"],"syntax":"swift"},{"type":"heading","text":"Middleware Pipeline","level":3,"anchor":"Middleware-Pipeline"},{"type":"paragraph","inlineContent":[{"type":"text","text":"NetworkClient processes requests through a middleware pipeline:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Request Middleware","type":"text"}],"type":"strong"},{"type":"text","text":": Transform requests before execution"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Network Execution","type":"text"}]},{"type":"text","text":": Perform the actual HTTP request"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Response Middleware","type":"text"}]},{"text":": Process responses after execution","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Error Middleware"}],"type":"strong"},{"text":": Handle any errors that occur","type":"text"}]}]}]},{"type":"codeListing","code":["\/\/ Middleware processing flow","Request → Request Middleware → Network → Response Middleware → Response","    ↓                                          ↓","Error Middleware ← ← ← ← ← ← ← ← ← ← ← ← ← ← Error"],"syntax":"swift"},{"type":"heading","text":"Configuration Components","level":2,"anchor":"Configuration-Components"},{"type":"heading","text":"Base Configuration","level":3,"anchor":"Base-Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Essential configuration for every client:"}]},{"type":"codeListing","code":["let client = NetworkClient {","    \/\/ Required base URL","    BaseURL(\"https:\/\/api.example.com\")","    ","    \/\/ Default request timeout","    DefaultTimeout(30.0)","    ","    \/\/ Default headers applied to all requests","    DefaultHeader(\"Accept\", \"application\/json\")","    DefaultHeader(\"User-Agent\", \"MyApp\/1.0\")","}"],"syntax":"swift"},{"type":"heading","text":"Session Configuration","level":3,"anchor":"Session-Configuration"},{"inlineContent":[{"text":"Customize the underlying URLSession:","type":"text"}],"type":"paragraph"},{"code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    Session {","        AllowsCellularAccess(true)","        AllowsExpensiveNetworkAccess(false)","        TimeoutIntervalForRequest(60.0)","        HTTPMaximumConnectionsPerHost(4)","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Authentication Configuration","level":3,"anchor":"Authentication-Configuration","type":"heading"},{"inlineContent":[{"text":"Add authentication to all requests:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Bearer token authentication","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    BearerToken(\"your-api-key\")","}","","\/\/ Basic authentication","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    BasicAuth(username: \"user\", password: \"pass\")","}","","\/\/ Custom authentication","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    CustomAuth { request in","        var modifiedRequest = request","        modifiedRequest.headers[\"X-API-Key\"] = \"secret-key\"","        return modifiedRequest","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Making Requests","level":2,"anchor":"Making-Requests","type":"heading"},{"text":"Using Request Builder","level":3,"anchor":"Using-Request-Builder","type":"heading"},{"inlineContent":[{"text":"The most flexible way to make requests:","type":"text"}],"type":"paragraph"},{"code":["let response = try await client.execute {","    POST(\"\/api\/users\")","    Header(\"Content-Type\", \"application\/json\")","    JSONBody(user)","    Timeout(15.0)","}"],"type":"codeListing","syntax":"swift"},{"text":"Direct Request Objects","level":3,"anchor":"Direct-Request-Objects","type":"heading"},{"inlineContent":[{"type":"text","text":"For programmatic request creation:"}],"type":"paragraph"},{"code":["let request = HTTPRequest(","    method: .post,","    url: URL(string: \"https:\/\/api.example.com\/users\")!,","    headers: [\"Content-Type\": \"application\/json\"],","    body: jsonData",")","","let response = try await client.execute(request)"],"type":"codeListing","syntax":"swift"},{"text":"Response Processing","level":3,"anchor":"Response-Processing","type":"heading"},{"inlineContent":[{"type":"text","text":"Process responses with built-in utilities:"}],"type":"paragraph"},{"code":["let response = try await client.execute {","    GET(\"\/api\/user\/123\")","}","","\/\/ Decode JSON directly","let user: User = try response.decode(User.self)","","\/\/ Check status","if response.status.isSuccess {","    print(\"Success!\")","} else {","    print(\"Request failed: \\(response.status)\")","}","","\/\/ Access headers","let contentType = response.headers[\"Content-Type\"]"],"type":"codeListing","syntax":"swift"},{"text":"Middleware Integration","level":2,"anchor":"Middleware-Integration","type":"heading"},{"text":"Built-in Middleware","level":3,"anchor":"Built-in-Middleware","type":"heading"},{"inlineContent":[{"type":"text","text":"Enable common middleware with simple configuration:"}],"type":"paragraph"},{"code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    ","    \/\/ Enable retry with default settings","    EnableRetry()","    ","    \/\/ Enable caching with custom policy","    EnableCaching {","        Policy(.aggressive)","        Duration(.hours(2))","    }","    ","    \/\/ Enable request\/response logging","    EnableLogging()","}"],"type":"codeListing","syntax":"swift"},{"text":"Custom Middleware","level":3,"anchor":"Custom-Middleware","type":"heading"},{"inlineContent":[{"type":"text","text":"Add custom middleware for specialized needs:"}],"type":"paragraph"},{"code":["\/\/ Custom request middleware","struct APIVersionMiddleware: HTTPRequestMiddleware {","    func modifyRequest(_ request: HTTPRequest) async throws -> HTTPRequest {","        var modifiedRequest = request","        modifiedRequest.headers[\"X-API-Version\"] = \"v2\"","        return modifiedRequest","    }","}","","\/\/ Custom response middleware  ","struct TimingMiddleware: HTTPResponseMiddleware {","    func processResponse(_ response: HTTPResponse) async throws -> HTTPResponse {","        let duration = response.headers[\"X-Response-Time\"] ?? \"unknown\"","        print(\"Request took: \\(duration)ms\")","        return response","    }","}","","\/\/ Add to client","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    Middleware(APIVersionMiddleware())","    Middleware(TimingMiddleware())","}"],"type":"codeListing","syntax":"swift"},{"text":"Error Handling","level":2,"anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"text":"NetworkClient provides comprehensive error handling:","type":"text"}],"type":"paragraph"},{"code":["do {","    let response = try await client.execute {","        GET(\"\/api\/protected-resource\")","    }","    \/\/ Handle success","} catch let error as HTTPError {","    switch error.category {","    case .network(.noConnection):","        \/\/ Handle offline scenarios","        print(\"No internet connection available\")","        ","    case .http(let status) where status.code == 401:","        \/\/ Handle authentication errors","        print(\"Authentication required\")","        ","    case .http(let status) where status.isServerError:","        \/\/ Handle server errors","        print(\"Server error: \\(status.reasonPhrase)\")","        ","    case .timeout:","        \/\/ Handle timeouts","        print(\"Request timed out\")","        ","    default:","        \/\/ Handle other errors","        print(\"Request failed: \\(error.userFriendlyDescription)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Concurrency & Thread Safety","level":2,"anchor":"Concurrency--Thread-Safety","type":"heading"},{"inlineContent":[{"type":"text","text":"NetworkClient is fully thread-safe and designed for concurrent usage:"}],"type":"paragraph"},{"syntax":"swift","code":["let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","}","","\/\/ Safe to use concurrently","async let user = client.execute { GET(\"\/user\/123\") }","async let posts = client.execute { GET(\"\/user\/123\/posts\") }","async let comments = client.execute { GET(\"\/user\/123\/comments\") }","","let (userResponse, postsResponse, commentsResponse) = try await (user, posts, comments)"],"type":"codeListing"},{"text":"Performance Considerations","anchor":"Performance-Considerations","type":"heading","level":2},{"text":"Connection Reuse","anchor":"Connection-Reuse","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"NetworkClient automatically reuses connections for efficiency:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ The same client instance will reuse connections","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","}","","\/\/ Multiple requests will share connections","for i in 1...10 {","    let response = try await client.execute { GET(\"\/data\/\\(i)\") }","}"],"type":"codeListing"},{"text":"Request Coalescing","anchor":"Request-Coalescing","type":"heading","level":3},{"inlineContent":[{"text":"Avoid duplicate concurrent requests:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Instead of multiple concurrent identical requests","Task {","    let response1 = try await client.execute { GET(\"\/expensive-operation\") }","}","Task {","    let response2 = try await client.execute { GET(\"\/expensive-operation\") }","}","","\/\/ Consider caching or request deduplication","let client = NetworkClient {","    BaseURL(\"https:\/\/api.example.com\")","    EnableCaching {","        Policy(.standard)","        Duration(.minutes(5))","    }","}"],"type":"codeListing"},{"text":"Testing Support","anchor":"Testing-Support","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"NetworkClient is designed to be easily testable:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Mock client for testing","class MockHTTPClient: HTTPClient {","    var responses: [HTTPResponse] = []","    ","    func execute(_ request: HTTPRequest) async throws -> HTTPResponse {","        return responses.removeFirst()","    }","}","","\/\/ Use in tests","let mockClient = MockHTTPClient()","mockClient.responses = [","    HTTPResponse(request: request, status: .ok, headers: [:], body: testData, url: nil)","]","","let response = try await mockClient.execute(testRequest)"],"type":"codeListing"},{"text":"Best Practices","anchor":"Best-Practices","type":"heading","level":2},{"text":"Client Lifecycle","anchor":"Client-Lifecycle","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Create one client instance per base URL\/configuration","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Reuse client instances across your application"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Store clients as singletons or dependency injection","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Configuration","anchor":"Configuration","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Set appropriate timeouts for your use case","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Configure retry logic for transient failures"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enable caching for appropriate requests","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Use middleware to avoid repetitive request modifications"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":3,"anchor":"Error-Handling","text":"Error Handling"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Always handle HTTPError specifically"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide user-friendly error messages"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Implement appropriate retry strategies","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Log detailed error information for debugging"}]}]}]},{"type":"heading","level":3,"anchor":"Performance","text":"Performance"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Reuse client instances to benefit from connection pooling","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Configure reasonable timeouts to avoid hanging requests","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use caching to reduce network traffic"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Monitor performance with observability middleware","type":"text"}]}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.brunogama.networking\/documentation\/Networking"]]},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/com.brunogama.networking\/documentation\/Networking\/ClientConfiguration","doc:\/\/com.brunogama.networking\/documentation\/Networking\/MiddlewareOverview","doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestBuilding"]}],"sections":[],"metadata":{"role":"article","roleHeading":"Article","title":"NetworkClient"},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"The primary HTTP client implementation with comprehensive middleware support and declarative configuration."}],"references":{"doc://com.brunogama.networking/documentation/Networking/ClientConfiguration":{"title":"Client Configuration","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/ClientConfiguration","kind":"article","abstract":[{"text":"Comprehensive configuration options for NetworkClient using the declarative configuration DSL.","type":"text"}],"type":"topic","role":"article","url":"\/documentation\/networking\/clientconfiguration"},"doc://com.brunogama.networking/documentation/Networking/MiddlewareOverview":{"url":"\/documentation\/networking\/middlewareoverview","type":"topic","abstract":[{"text":"Extensible request and response processing pipeline for cross-cutting concerns like authentication, caching, retry logic, and observability.","type":"text"}],"kind":"article","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/MiddlewareOverview","title":"Middleware Overview","role":"article"},"doc://com.brunogama.networking/documentation/Networking":{"title":"Networking","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking","kind":"article","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/networking"},"doc://com.brunogama.networking/documentation/Networking/RequestBuilding":{"type":"topic","url":"\/documentation\/networking\/requestbuilding","abstract":[{"type":"text","text":"Build HTTP requests declaratively using the RequestBuilder DSL and component system."}],"kind":"article","role":"article","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestBuilding","title":"Request Building"}}}