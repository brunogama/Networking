{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestBuilding","doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestComponents","doc:\/\/com.brunogama.networking\/documentation\/Networking\/HTTPMethods"],"anchor":"Related-Documentation"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.brunogama.networking\/documentation\/Networking"]]},"sections":[],"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"Conditional Requests"},"abstract":[{"type":"text","text":"Build dynamic HTTP requests that adapt to runtime conditions using conditional components and control flow."}],"identifier":{"url":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/ConditionalRequests","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Conditional request building allows you to construct HTTP requests that change based on runtime conditions, user state, feature flags, or other dynamic factors. This enables you to write flexible, maintainable request code that adapts to different scenarios without duplicating logic."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The conditional request system supports:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"If\/Else Logic"}],"type":"strong"},{"text":": Standard Swift control flow within request builders","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Conditional Components","type":"text"}],"type":"strong"},{"text":": Helper components for common conditional patterns","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Switch Statements"}],"type":"strong"},{"text":": Multiple condition handling","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Optional Components"}],"type":"strong"},{"text":": Apply components only when values are available","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Feature Flags","type":"text"}],"type":"strong"},{"text":": Enable\/disable request features dynamically","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Basic-Conditional-Logic","level":2,"text":"Basic Conditional Logic"},{"type":"heading","anchor":"If-Statements","level":3,"text":"If Statements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use standard Swift if statements within request builders:"}]},{"type":"codeListing","syntax":"swift","code":["let includeAuth = user.isLoggedIn","let includePremiumFeatures = user.isPremium","","let request = HTTPRequest {","    GET(\"\/api\/profile\")","    ","    \/\/ Conditional authentication","    if includeAuth {","        BearerAuth(user.token)","        Header(\"X-User-ID\", user.id)","    }","    ","    \/\/ Conditional premium features","    if includePremiumFeatures {","        QueryParam(\"include\", \"premium-features\")","        Header(\"X-Plan\", \"premium\")","    }","}"]},{"type":"heading","anchor":"If-Else-Logic","level":3,"text":"If-Else Logic"},{"type":"paragraph","inlineContent":[{"text":"Handle mutually exclusive conditions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let request = HTTPRequest {","    GET(\"\/api\/data\")","    ","    \/\/ Authentication method based on user type","    if user.isServiceAccount {","        APIKey(\"X-Service-Key\", user.serviceKey)","    } else if user.isLoggedIn {","        BearerAuth(user.token)","    } else {","        \/\/ Anonymous access","        Header(\"X-Anonymous\", \"true\")","    }","    ","    \/\/ Content type preference","    if userPreferences.prefersJSON {","        AcceptHeader(.json)","    } else {","        AcceptHeader(.xml)","    }","}"]},{"type":"heading","anchor":"Switch-Statements","level":3,"text":"Switch Statements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle multiple conditions elegantly:"}]},{"type":"codeListing","syntax":"swift","code":["enum UserRole {","    case admin, moderator, user, guest","}","","let request = HTTPRequest {","    GET(\"\/api\/content\")","    ","    switch user.role {","    case .admin:","        Header(\"X-Admin-Access\", \"full\")","        QueryParam(\"include_all\", \"true\")","        ","    case .moderator:","        Header(\"X-Moderator-Access\", \"limited\")","        QueryParam(\"include_moderated\", \"true\")","        ","    case .user:","        Header(\"X-User-Access\", \"standard\")","        ","    case .guest:","        Header(\"X-Guest-Access\", \"public\")","        QueryParam(\"public_only\", \"true\")","    }","}"]},{"type":"heading","anchor":"Conditional-Components","level":2,"text":"Conditional Components"},{"type":"heading","anchor":"ConditionalComponent-Helper","level":3,"text":"ConditionalComponent Helper"},{"type":"paragraph","inlineContent":[{"text":"Use the built-in conditional component for cleaner code:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let request = HTTPRequest {","    GET(\"\/api\/data\")","    ","    ConditionalComponent(user.isLoggedIn) {","        BearerAuth(user.token)","        Header(\"X-User-ID\", user.id)","    }","    ","    ConditionalComponent(!searchTerm.isEmpty) {","        QueryParam(\"search\", searchTerm)","        QueryParam(\"highlight\", \"true\")","    }","    ","    ConditionalComponent(includeMetadata) {","        QueryParam(\"include_metadata\", \"true\")","        Header(\"X-Metadata-Level\", \"full\")","    }","}"]},{"type":"heading","anchor":"Custom-Conditional-Components","level":3,"text":"Custom Conditional Components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create reusable conditional logic:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Authentication conditional component","struct AuthenticationComponent: RequestComponent {","    let user: User?","    ","    func apply(to request: inout HTTPRequest) throws {","        guard let user = user else { return }","        ","        if user.isServiceAccount {","            request.headers[\"X-Service-Key\"] = user.serviceKey","        } else if let token = user.accessToken {","            request.headers[\"Authorization\"] = \"Bearer \\(token)\"","        }","        ","        request.headers[\"X-User-ID\"] = user.id","    }","}","","\/\/ Feature flag conditional component","struct FeatureFlagComponent: RequestComponent {","    let flagName: String","    let components: [RequestComponent]","    ","    init(_ flagName: String, @RequestBuilder components: () -> [RequestComponent]) {","        self.flagName = flagName","        self.components = components()","    }","    ","    func apply(to request: inout HTTPRequest) throws {","        guard FeatureFlags.isEnabled(flagName) else { return }","        ","        for component in components {","            try component.apply(to: &request)","        }","    }","}","","\/\/ Usage","let request = HTTPRequest {","    GET(\"\/api\/data\")","    AuthenticationComponent(user: currentUser)","    ","    FeatureFlagComponent(\"new-api-features\") {","        Header(\"X-API-Version\", \"v2\")","        QueryParam(\"use_new_format\", \"true\")","    }","}"]},{"type":"heading","anchor":"Optional-Value-Handling","level":2,"text":"Optional Value Handling"},{"type":"heading","anchor":"Optional-Unwrapping","level":3,"text":"Optional Unwrapping"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle optional values gracefully:"}]},{"type":"codeListing","syntax":"swift","code":["let request = HTTPRequest {","    GET(\"\/api\/search\")","    ","    \/\/ Optional search parameters","    if let query = searchQuery {","        QueryParam(\"q\", query)","    }","    ","    if let location = userLocation {","        QueryParam(\"lat\", \"\\(location.latitude)\")","        QueryParam(\"lng\", \"\\(location.longitude)\")","    }","    ","    if let radius = searchRadius {","        QueryParam(\"radius\", \"\\(radius)\")","    }","}"]},{"type":"heading","anchor":"Nil-Coalescing","level":3,"text":"Nil Coalescing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use default values for optional parameters:"}]},{"syntax":"swift","code":["let request = HTTPRequest {","    GET(\"\/api\/data\")","    ","    QueryParam(\"page\", \"\\(page ?? 1)\")","    QueryParam(\"limit\", \"\\(limit ?? 25)\")","    QueryParam(\"sort\", sortField ?? \"created_at\")","    QueryParam(\"order\", sortOrder ?? \"desc\")","    ","    \/\/ Optional authentication with fallback","    if let token = userToken ?? appToken {","        BearerAuth(token)","    }","}"],"type":"codeListing"},{"text":"Compact Map Patterns","anchor":"Compact-Map-Patterns","level":3,"type":"heading"},{"inlineContent":[{"text":"Apply multiple optional components:","type":"text"}],"type":"paragraph"},{"code":["struct OptionalQueryParam: RequestComponent {","    let name: String","    let value: String?","    ","    func apply(to request: inout HTTPRequest) throws {","        if let value = value {","            \/\/ Apply query parameter logic","            var components = URLComponents(url: request.url, resolvingAgainstBaseURL: false)","            var queryItems = components?.queryItems ?? []","            queryItems.append(URLQueryItem(name: name, value: value))","            components?.queryItems = queryItems","            ","            if let newURL = components?.url {","                request = HTTPRequest(","                    method: request.method,","                    url: newURL,","                    headers: request.headers,","                    body: request.body,","                    timeout: request.timeout","                )","            }","        }","    }","}","","\/\/ Usage with multiple optional parameters","let request = HTTPRequest {","    GET(\"\/api\/search\")","    ","    OptionalQueryParam(\"category\", category)","    OptionalQueryParam(\"tag\", selectedTag)","    OptionalQueryParam(\"author\", authorId)","    OptionalQueryParam(\"since\", sinceDate?.iso8601String)","}"],"syntax":"swift","type":"codeListing"},{"text":"Advanced Conditional Patterns","level":2,"anchor":"Advanced-Conditional-Patterns","type":"heading"},{"text":"Environment-Based Configuration","level":3,"anchor":"Environment-Based-Configuration","type":"heading"},{"inlineContent":[{"type":"text","text":"Adapt requests based on environment:"}],"type":"paragraph"},{"code":["enum Environment {","    case development, staging, production","    ","    static var current: Environment {","        \/\/ Determine environment","        return .development","    }","}","","let request = HTTPRequest {","    GET(\"\/api\/data\")","    ","    switch Environment.current {","    case .development:","        Header(\"X-Debug\", \"true\")","        Header(\"X-Environment\", \"dev\")","        RequestTimeout(60.0) \/\/ Longer timeout for debugging","        ","    case .staging:","        Header(\"X-Environment\", \"staging\")","        Header(\"X-Test-Mode\", \"true\")","        ","    case .production:","        Header(\"X-Environment\", \"prod\")","        \/\/ Production-specific headers","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Platform-Specific Components","level":3,"anchor":"Platform-Specific-Components","type":"heading"},{"inlineContent":[{"type":"text","text":"Handle platform differences:"}],"type":"paragraph"},{"code":["let request = HTTPRequest {","    POST(\"\/api\/analytics\")","    JSONBody(analyticsData)","    ","    #if os(iOS)","    Header(\"X-Platform\", \"iOS\")","    Header(\"X-Device-Type\", UIDevice.current.userInterfaceIdiom.description)","    #elseif os(macOS)","    Header(\"X-Platform\", \"macOS\")","    Header(\"X-App-Kit-Version\", NSAppKitVersion.current.rawValue.description)","    #elseif os(watchOS)","    Header(\"X-Platform\", \"watchOS\")","    Header(\"X-Watch-Model\", WKInterfaceDevice.current().model)","    #elseif os(tvOS)","    Header(\"X-Platform\", \"tvOS\")","    #endif","    ","    \/\/ App version based on platform","    if let version = Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String {","        Header(\"X-App-Version\", version)","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Feature Flag Integration","level":3,"anchor":"Feature-Flag-Integration","type":"heading"},{"inlineContent":[{"type":"text","text":"Integrate with feature flag systems:"}],"type":"paragraph"},{"code":["\/\/ Feature flag service","class FeatureFlags {","    static func isEnabled(_ flag: String) -> Bool {","        \/\/ Feature flag implementation","        return UserDefaults.standard.bool(forKey: \"feature_\\(flag)\")","    }","    ","    static func getValue<T>(_ flag: String) -> T? {","        return UserDefaults.standard.object(forKey: \"feature_\\(flag)\") as? T","    }","}","","\/\/ Feature flag components","struct FeatureAwareRequest: RequestComponent {","    func apply(to request: inout HTTPRequest) throws {","        \/\/ Beta API features","        if FeatureFlags.isEnabled(\"beta_api\") {","            request.headers[\"X-Beta-API\"] = \"true\"","            request.headers[\"X-API-Version\"] = \"beta\"","        }","        ","        \/\/ Enhanced analytics","        if FeatureFlags.isEnabled(\"enhanced_analytics\") {","            request.headers[\"X-Analytics-Level\"] = \"detailed\"","        }","        ","        \/\/ Custom timeout","        if let customTimeout: Double = FeatureFlags.getValue(\"api_timeout\") {","            request.timeout = customTimeout","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"User Preference Adaptation","level":3,"anchor":"User-Preference-Adaptation","type":"heading"},{"inlineContent":[{"type":"text","text":"Adapt requests based on user preferences:"}],"type":"paragraph"},{"code":["struct UserPreferences {","    let language: String","    let timezone: String","    let dataUsageMode: DataUsageMode","    let accessibilityNeeds: AccessibilityNeeds","}","","enum DataUsageMode {","    case unrestricted, reduced, minimal","}","","struct PreferenceAwareComponent: RequestComponent {","    let preferences: UserPreferences","    ","    func apply(to request: inout HTTPRequest) throws {","        \/\/ Localization","        request.headers[\"Accept-Language\"] = preferences.language","        request.headers[\"X-Timezone\"] = preferences.timezone","        ","        \/\/ Data usage optimization","        switch preferences.dataUsageMode {","        case .unrestricted:","            request.headers[\"X-Quality\"] = \"high\"","            request.headers[\"X-Include-Images\"] = \"true\"","            ","        case .reduced:","            request.headers[\"X-Quality\"] = \"medium\"","            request.headers[\"X-Compress\"] = \"true\"","            ","        case .minimal:","            request.headers[\"X-Quality\"] = \"low\"","            request.headers[\"X-Text-Only\"] = \"true\"","        }","        ","        \/\/ Accessibility","        if preferences.accessibilityNeeds.needsHighContrast {","            request.headers[\"X-High-Contrast\"] = \"true\"","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Conditional Body Content","level":2,"anchor":"Conditional-Body-Content","type":"heading"},{"text":"Dynamic Body Selection","level":3,"anchor":"Dynamic-Body-Selection","type":"heading"},{"inlineContent":[{"text":"Choose different body content based on conditions:","type":"text"}],"type":"paragraph"},{"code":["struct User: Codable {","    let id: String","    let name: String","    let email: String","    let profileImage: Data?","}","","let request = HTTPRequest {","    POST(\"\/api\/users\")","    ","    \/\/ Choose serialization format based on data size","    if let imageData = user.profileImage, imageData.count > 1_000_000 {","        \/\/ Use multipart for large images","        MultipartBody {","            TextPart(\"user\", JSONEncoder().encode(user))","            DataPart(\"image\", imageData, mimeType: \"image\/jpeg\")","        }","    } else {","        \/\/ Use JSON for smaller payloads","        JSONBody(user)","        ContentType(.json)","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Conditional Encoding","level":3,"anchor":"Conditional-Encoding","type":"heading"},{"inlineContent":[{"text":"Handle different encoding requirements:","type":"text"}],"type":"paragraph"},{"code":["let request = HTTPRequest {","    PUT(\"\/api\/data\")","    ","    if clientSupportsCompression {","        \/\/ Compressed JSON","        let compressedData = try JSONEncoder().encode(data).compressed()","        DataBody(compressedData)","        Header(\"Content-Encoding\", \"gzip\")","        ContentType(.json)","    } else {","        \/\/ Standard JSON","        JSONBody(data)","    }","    ","    if requiresEncryption {","        Header(\"X-Encrypted\", \"true\")","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Error Handling in Conditional Requests","level":2,"anchor":"Error-Handling-in-Conditional-Requests","type":"heading"},{"text":"Conditional Validation","level":3,"anchor":"Conditional-Validation","type":"heading"},{"inlineContent":[{"text":"Add validation based on request configuration:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ConditionalValidation: RequestComponent {","    let strictMode: Bool","    ","    func apply(to request: inout HTTPRequest) throws {","        if strictMode {","            \/\/ Strict validation","            guard !request.headers.isEmpty else {","                throw RequestError.validationFailed(\"Headers required in strict mode\")","            }","            ","            guard request.headers[\"Authorization\"] != nil else {","                throw RequestError.validationFailed(\"Authentication required in strict mode\")","            }","        }","        ","        \/\/ Always validate URL","        guard request.url.scheme != nil else {","            throw RequestError.invalidURL(\"URL scheme is required\")","        }","    }","}"]},{"type":"heading","text":"Fallback Strategies","level":3,"anchor":"Fallback-Strategies"},{"type":"paragraph","inlineContent":[{"text":"Implement fallback mechanisms:","type":"text"}]},{"type":"codeListing","code":["struct FallbackAuthentication: RequestComponent {","    let primaryToken: String?","    let fallbackToken: String?","    let allowAnonymous: Bool","    ","    func apply(to request: inout HTTPRequest) throws {","        if let primary = primaryToken {","            request.headers[\"Authorization\"] = \"Bearer \\(primary)\"","        } else if let fallback = fallbackToken {","            request.headers[\"Authorization\"] = \"Bearer \\(fallback)\"","            request.headers[\"X-Fallback-Auth\"] = \"true\"","        } else if allowAnonymous {","            request.headers[\"X-Anonymous\"] = \"true\"","        } else {","            throw RequestError.authenticationRequired(\"No valid authentication available\")","        }","    }","}"],"syntax":"swift"},{"text":"Testing Conditional Requests","level":2,"anchor":"Testing-Conditional-Requests","type":"heading"},{"text":"Test Different Conditions","level":3,"anchor":"Test-Different-Conditions","type":"heading"},{"inlineContent":[{"type":"text","text":"Create tests for various conditional paths:"}],"type":"paragraph"},{"type":"codeListing","code":["func testConditionalAuthentication() async throws {","    \/\/ Test with logged-in user","    let authenticatedRequest = HTTPRequest {","        GET(\"\/api\/data\")","        ConditionalComponent(true) { \/\/ user.isLoggedIn","            BearerAuth(\"test-token\")","        }","    }","    ","    XCTAssertEqual(authenticatedRequest.headers[\"Authorization\"], \"Bearer test-token\")","    ","    \/\/ Test with anonymous user","    let anonymousRequest = HTTPRequest {","        GET(\"\/api\/data\")","        ConditionalComponent(false) { \/\/ user.isLoggedIn","            BearerAuth(\"test-token\")","        }","    }","    ","    XCTAssertNil(anonymousRequest.headers[\"Authorization\"])","}","","func testEnvironmentConfiguration() throws {","    \/\/ Mock different environments","    let environments = [Environment.development, .staging, .production]","    ","    for env in environments {","        let request = HTTPRequest {","            GET(\"\/api\/test\")","            ","            switch env {","            case .development:","                Header(\"X-Debug\", \"true\")","            case .staging:","                Header(\"X-Test\", \"true\")","            case .production:","                Header(\"X-Production\", \"true\")","            }","        }","        ","        \/\/ Verify appropriate headers are set","        switch env {","        case .development:","            XCTAssertEqual(request.headers[\"X-Debug\"], \"true\")","        case .staging:","            XCTAssertEqual(request.headers[\"X-Test\"], \"true\")","        case .production:","            XCTAssertEqual(request.headers[\"X-Production\"], \"true\")","        }","    }","}"],"syntax":"swift"},{"text":"Best Practices","level":2,"anchor":"Best-Practices","type":"heading"},{"text":"Conditional Request Guidelines","level":3,"anchor":"Conditional-Request-Guidelines","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Readability:"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Keep conditional logic simple and clear"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use descriptive variable names for conditions","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Group related conditional components together","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"inlineContent":[{"text":"Performance:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Avoid expensive condition evaluation in request building","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Cache computed conditions when possible"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Use early returns in conditional components"}],"type":"paragraph"}]}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Maintainability:"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Extract complex conditional logic into custom components"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Use enums instead of magic strings for conditions"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Document complex conditional behavior"}]}]}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Testing:"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Test all conditional paths","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Mock external dependencies (feature flags, user state)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify both positive and negative conditions"}],"type":"paragraph"}]}]}],"kind":"content"}],"references":{"doc://com.brunogama.networking/documentation/Networking/RequestBuilding":{"type":"topic","url":"\/documentation\/networking\/requestbuilding","abstract":[{"type":"text","text":"Build HTTP requests declaratively using the RequestBuilder DSL and component system."}],"kind":"article","role":"article","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestBuilding","title":"Request Building"},"doc://com.brunogama.networking/documentation/Networking/RequestComponents":{"url":"\/documentation\/networking\/requestcomponents","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/RequestComponents","title":"Request Components","abstract":[{"type":"text","text":"Modular building blocks for constructing HTTP requests with the RequestComponent protocol."}],"type":"topic","role":"article","kind":"article"},"doc://com.brunogama.networking/documentation/Networking":{"title":"Networking","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking","kind":"article","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/networking"},"doc://com.brunogama.networking/documentation/Networking/HTTPMethods":{"url":"\/documentation\/networking\/httpmethods","identifier":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/HTTPMethods","title":"HTTP Methods","abstract":[{"type":"text","text":"Comprehensive HTTP method support with type-safe method definitions and custom method capabilities."}],"type":"topic","role":"article","kind":"article"}}}