{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.brunogama.networking\/documentation\/Networking\/HTTPMethods"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"The Networking framework provides complete support for HTTP methods through the ","type":"text"},{"code":"HTTPMethod","type":"codeVoice"},{"text":" type and dedicated request components. This includes all standard HTTP methods as well as support for custom methods when needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The HTTP method system consists of:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"HTTPMethod Type","type":"text"}],"type":"strong"},{"type":"text","text":": Type-safe representation of HTTP methods"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Method Components","type":"text"}],"type":"strong"},{"type":"text","text":": Declarative components for each standard method"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Custom Method Support","type":"text"}]},{"type":"text","text":": Ability to use non-standard HTTP methods"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Method Validation","type":"text"}]},{"text":": Runtime validation for method appropriateness","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"HTTPMethod-Type","level":2,"text":"HTTPMethod Type"},{"type":"heading","anchor":"Standard-Methods","level":3,"text":"Standard Methods"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The framework provides predefined constants for all standard HTTP methods:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Standard HTTP methods","public static let get = HTTPMethod(\"GET\")","public static let post = HTTPMethod(\"POST\") ","public static let put = HTTPMethod(\"PUT\")","public static let delete = HTTPMethod(\"DELETE\")","public static let patch = HTTPMethod(\"PATCH\")","public static let head = HTTPMethod(\"HEAD\")","public static let options = HTTPMethod(\"OPTIONS\")","public static let trace = HTTPMethod(\"TRACE\")","public static let connect = HTTPMethod(\"CONNECT\")"]},{"type":"heading","anchor":"Method-Properties","level":3,"text":"Method Properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"HTTPMethod provides useful properties for method classification:"}]},{"type":"codeListing","syntax":"swift","code":["let method = HTTPMethod.post","","\/\/ Check method characteristics","if method.isIdempotent {","    print(\"Method is idempotent\")","}","","if method.isBodyAllowed {","    print(\"Method allows request body\")","}","","if method.isResponseBodyExpected {","    print(\"Method typically returns response body\")","}"]},{"type":"heading","anchor":"Creating-Custom-Methods","level":3,"text":"Creating Custom Methods"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Support for non-standard HTTP methods:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Custom method for specific APIs","let customMethod = HTTPMethod(\"PATCH-MERGE\")","let webdavMethod = HTTPMethod(\"PROPFIND\")","let calDavMethod = HTTPMethod(\"REPORT\")","","let request = HTTPRequest(","    method: customMethod,","    url: URL(string: \"https:\/\/api.example.com\/custom\")!",")"]},{"type":"heading","anchor":"Method-Components","level":2,"text":"Method Components"},{"text":"GET Requests","anchor":"GET-Requests","level":3,"type":"heading"},{"inlineContent":[{"text":"Use GET for retrieving data without side effects:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Simple GET request","let request = HTTPRequest {","    GET(\"\/api\/users\")","}","","\/\/ GET with query parameters","let request = HTTPRequest {","    GET(\"\/api\/search\")","    QueryParam(\"q\", \"swif