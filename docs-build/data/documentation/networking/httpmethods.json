ntent":[{"text":"Creating new resources","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Form submissions","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"File uploads"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Non-idempotent operations","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Operations with side effects","type":"text"}]}]}]},{"text":"PUT Requests","level":3,"type":"heading","anchor":"PUT-Requests"},{"type":"paragraph","inlineContent":[{"text":"Use PUT for creating or completely replacing resources:","type":"text"}]},{"type":"codeListing","code":["\/\/ PUT to update entire resource","let request = HTTPRequest {","    PUT(\"\/api\/users\/123\")","    JSONBody(updatedUser)","    ContentType(.json)","    Header(\"If-Match\", etag)","}","","\/\/ PUT to create resource with known ID","let request = HTTPRequest {","    PUT(\"\/api\/documents\/new-doc-id\")","    JSONBody(document)","    ContentType(.json)","}","","\/\/ PUT with conditional headers","let request = HTTPRequest {","    PUT(\"\/api\/config\")","    JSONBody(configuration)","    Header(\"If-None-Match\", \"*\") \/\/ Only create, don't update","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"When to use PUT:"}]}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Complete resource replacement","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Creating resources with known IDs"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Idempotent updates"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Configuration changes","type":"text"}]}]}]},{"anchor":"PATCH-Requests","level":3,"type":"heading","text":"PATCH Requests"},{"inlineContent":[{"type":"text","text":"Use PATCH for partial resource updates:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ PATCH for partial update","struct UserUpdate: Codable {","    let name: String?","    let email: String?","}","","let request = HTTPRequest {","    PATCH(\"\/api\/users\/123\")","    JSONBody(UserUpdate(name: \"New Name\", email: nil))","    ContentType(.json)","    Header(\"If-Match\", etag)","}","","\/\/ PATCH with JSON Patch format","let jsonPatch = [","    [\"op\": \"replace\", \"path\": \"\/name\", \"value\": \"New Name\"],","    [\"op\": \"remove\", \"path\": \"\/temporary_field\"]","]","","let request = HTTPRequest {","    PATCH(\"\/api\/users\/123\")","    JSONBody(jsonPatch)","    ContentType(\"application\/json-patch+json\")","}"]},{"inlineContent":[{"inlineContent":[{"text":"When to use PATCH:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Partial resource updates"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optimistic updates"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Bandwidth-efficient updates","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"JSON Patch operations"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"DELETE-Requests","level":3,"type":"heading","text":"DELETE Requests"},{"inlineContent":[{"type":"text","text":"Use DELETE for removing resources:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Simple DELETE","let request = HTTPRequest {","    DELETE(\"\/api\/users\/123\")","    BearerAuth(token)","}","","\/\/ DELETE with confirmation","let request = HTTPRequest {","    DELETE(\"\/api\/users\/123\")","    Header(\"X-Confirm-Delete\", \"true\")","    BearerAuth(token)","}","","\/\/ Soft delete with body","let request = HTTPRequest {","    DELETE(\"\/api\/users\/123\")","    JSONBody([\"reason\": \"User requested account deletion\"])","    ContentType(.json)","}"]},{"inlineContent":[{"inlineContent":[{"text":"When to use DELETE:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Resource removal","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cleanup operations"}]}]},{"content":[{"inlineContent":[{"text":"Account deletion","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"File removal"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"HEAD Requests","level":3,"anchor":"HEAD-Requests"},{"inlineContent":[{"type":"text","text":"Use HEAD for metadata without response body:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Check if resource exists","let request = HTTPRequest {","    HEAD(\"\/api\/users\/123\")","}","","\/\/ Get file metadata","let request = HTTPRequest {","    HEAD(\"\/api\/files\/document.pdf\")","}","","\/\/ Check cache freshness","let request = HTTPRequest {","    HEAD(\"\/api\/data\")","    Header(\"If-Modified-Since\", lastModified)","}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"When to use HEAD:"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Resource existence checks","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Metadata retrieval","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cache validation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Bandwidth conservation","type":"text"}]}]}]},{"type":"heading","text":"OPTIONS Requests","level":3,"anchor":"OPTIONS-Requests"},{"inlineContent":[{"type":"text","text":"Use OPTIONS for capability discovery:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ CORS preflight","let request = HTTPRequest {","    OPTIONS(\"\/api\/users\")","    Header(\"Access-Control-Request-Method\", \"POST\")","    Header(\"Access-Control-Request-Headers\", \"Content-Type\")","}","","\/\/ API capability discovery","let request = HTTPRequest {","    OPTIONS(\"\/api\/endpoint\")","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"When to use OPTIONS:","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"CORS preflight requests"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"API capability discovery"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Method validation","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Method-Validation","level":2,"text":"Method Validation"},{"type":"heading","anchor":"Automatic-Validation","level":3,"text":"Automatic Validation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The framework provides automatic method validation:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ This will validate method appropriateness","let request = HTTPRequest {","    GET(\"\/api\/data\")","    JSONBody(data) \/\/ Warning: GET typically shouldn't have body","}","","\/\/ Framework validates method-body combinations","let request = HTTPRequest {","    HEAD(\"\/api\/resource\")","    \/\/ Response body will be automatically ignored for HEAD","}"]},{"type":"heading","anchor":"Custom-Validation","level":3,"text":"Custom Validation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement custom method validation:"}]},{"type":"codeListing","syntax":"swift","code":["struct ValidatedMethod: RequestComponent {","    let method: HTTPMethod","    let allowedMethods: Set<HTTPMethod>","    ","    init(_ method: HTTPMethod, allowedMethods: Set<HTTPMethod>) throws {","        guard allowedMethods.contains(method) else {","            throw RequestError.methodNotAllowed(method.rawValue)","        }","        self.method = method","    }","    ","    func apply(to request: inout HTTPRequest) throws {","        \/\/ Apply validated method","    }","}","","\/\/ Usage","let request = HTTPRequest {","    try ValidatedMethod(.post, allowedMethods: [.get, .post])","    Path(\"\/api\/endpoint\")","}"]},{"type":"heading","anchor":"Advanced-Method-Usage","level":2,"text":"Advanced Method Usage"},{"type":"heading","anchor":"Method-Overrides","level":3,"text":"Method Overrides"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle servers that don’t support all methods:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Method override for limited servers","let request = HTTPRequest {","    POST(\"\/api\/users\/123\") \/\/ Actual transport method","    Header(\"X-HTTP-Method-Override\", \"PUT\") \/\/ Intended method","    JSONBody(updatedUser)","}"]},{"type":"heading","anchor":"WebDAV-Methods","level":3,"text":"WebDAV Methods"},{"type":"paragraph","inlineContent":[{"text":"Support for WebDAV extensions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ WebDAV PROPFIND","let request = HTTPRequest {","    Method(\"PROPFIND\")","    Path(\"\/webdav\/folder\")","    XMLBody(propfindXML)","    ContentType(\"application\/xml\")","    Header(\"Depth\", \"1\")","}","","\/\/ WebDAV MKCOL","let request = HTTPRequest {","    Method(\"MKCOL\")","    Path(\"\/webdav\/new-collection\")","}"]},{"type":"heading","anchor":"CalDAVCardDAV-Methods","level":3,"text":"CalDAV\/CardDAV Methods"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Support for calendar and contact protocols:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ CalDAV REPORT","let request = HTTPRequest {","    Method(\"REPORT\")","    Path(\"\/calendar\/user\/calendar\")","    XMLBody(reportQuery)","    ContentType(\"application\/xml\")","    Header(\"Depth\", \"1\")","}","","\/\/ CardDAV PROPFIND","let request = HTTPRequest {","    Method(\"PROPFIND\")","    Path(\"\/contacts\/user\/addressbook\")","   